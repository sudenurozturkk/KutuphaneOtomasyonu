<Application x:Class="KutuphaneOtomasyonu.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <materialDesign:BundledTheme BaseTheme="Dark" PrimaryColor="DeepPurple" SecondaryColor="Teal" />
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesign2.Defaults.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Renkler -->
            <Color x:Key="PrimaryDark">#0A0E1A</Color>
            <Color x:Key="PrimaryMid">#0F1729</Color>
            <Color x:Key="PrimaryLight">#1A2540</Color>
            <Color x:Key="AccentBlue">#3B82F6</Color>
            <Color x:Key="AccentPurple">#8B5CF6</Color>
            <Color x:Key="AccentTeal">#14B8A6</Color>
            <Color x:Key="AccentGold">#F59E0B</Color>
            <Color x:Key="TextPrimary">#F1F5F9</Color>
            <Color x:Key="TextSecondary">#94A3B8</Color>
            <Color x:Key="Success">#10B981</Color>
            <Color x:Key="Warning">#F59E0B</Color>
            <Color x:Key="Error">#EF4444</Color>

            <SolidColorBrush x:Key="PrimaryDarkBrush" Color="{StaticResource PrimaryDark}"/>
            <SolidColorBrush x:Key="PrimaryMidBrush" Color="{StaticResource PrimaryMid}"/>
            <SolidColorBrush x:Key="PrimaryLightBrush" Color="{StaticResource PrimaryLight}"/>
            <SolidColorBrush x:Key="AccentBlueBrush" Color="{StaticResource AccentBlue}"/>
            <SolidColorBrush x:Key="AccentPurpleBrush" Color="{StaticResource AccentPurple}"/>
            <SolidColorBrush x:Key="AccentTealBrush" Color="{StaticResource AccentTeal}"/>
            <SolidColorBrush x:Key="AccentGoldBrush" Color="{StaticResource AccentGold}"/>
            <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimary}"/>
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondary}"/>
            <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource Success}"/>
            <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource Warning}"/>
            <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource Error}"/>

            <!-- Gradientler -->
            <LinearGradientBrush x:Key="PrimaryGradient" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#3B82F6" Offset="0"/>
                <GradientStop Color="#8B5CF6" Offset="1"/>
            </LinearGradientBrush>

            <LinearGradientBrush x:Key="SidebarGradient" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#0A0E1A" Offset="0"/>
                <GradientStop Color="#0F1729" Offset="1"/>
            </LinearGradientBrush>

            <LinearGradientBrush x:Key="CardGradient" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#1A2540" Offset="0"/>
                <GradientStop Color="#1E2D4A" Offset="1"/>
            </LinearGradientBrush>

            <!-- Global Font -->
            <FontFamily x:Key="PrimaryFont">Segoe UI</FontFamily>

            <!-- Kart Stili -->
            <Style x:Key="GlassCard" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource CardGradient}"/>
                <Setter Property="CornerRadius" Value="16"/>
                <Setter Property="Padding" Value="20"/>
                <Setter Property="Effect">
                    <Setter.Value>
                        <DropShadowEffect Color="#000000" BlurRadius="20" ShadowDepth="4" Opacity="0.3"/>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Buton Stili -->
            <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedButton}">
                <Setter Property="Background" Value="{StaticResource PrimaryGradient}"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="FontFamily" Value="{StaticResource PrimaryFont}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Height" Value="44"/>
                <Setter Property="Padding" Value="24,0"/>
                <Setter Property="materialDesign:ButtonAssist.CornerRadius" Value="22"/>
            </Style>

            <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource MaterialDesignOutlinedButton}">
                <Setter Property="BorderBrush" Value="{StaticResource AccentBlueBrush}"/>
                <Setter Property="Foreground" Value="{StaticResource AccentBlueBrush}"/>
                <Setter Property="FontFamily" Value="{StaticResource PrimaryFont}"/>
                <Setter Property="Height" Value="40"/>
                <Setter Property="materialDesign:ButtonAssist.CornerRadius" Value="20"/>
            </Style>

            <!-- DataGrid Stili -->
            <Style x:Key="ModernDataGrid" TargetType="DataGrid" BasedOn="{StaticResource MaterialDesignDataGrid}">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="GridLinesVisibility" Value="Horizontal"/>
                <Setter Property="HorizontalGridLinesBrush" Value="#1A2540"/>
                <Setter Property="RowBackground" Value="Transparent"/>
                <Setter Property="AlternatingRowBackground" Value="#0D1829"/>
                <Setter Property="FontFamily" Value="{StaticResource PrimaryFont}"/>
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            </Style>

            <!-- TextBox Stili -->
            <Style x:Key="ModernTextBox" TargetType="TextBox" BasedOn="{StaticResource MaterialDesignOutlinedTextBox}">
                <Setter Property="FontFamily" Value="{StaticResource PrimaryFont}"/>
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Padding" Value="12,4"/>
                <Setter Property="MinHeight" Value="44"/>
                <Setter Property="materialDesign:HintAssist.IsFloating" Value="False"/>
            </Style>
            <Style x:Key="ModernComboBox" TargetType="ComboBox" BasedOn="{StaticResource MaterialDesignOutlinedComboBox}">
                <Setter Property="FontFamily" Value="{StaticResource PrimaryFont}"/>
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Padding" Value="10,4"/>
                <Setter Property="MinHeight" Value="44"/>
                <Setter Property="ItemContainerStyle">
                    <Setter.Value>
                        <Style TargetType="ComboBoxItem">
                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                            <Setter Property="Padding" Value="8,4"/>
                            <Setter Property="MinHeight" Value="32"/>
                        </Style>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Koyu arama ve filtre alanlarinda Material Design ic bosluklarini korur. -->
            <Style x:Key="SearchTextBox" TargetType="TextBox" BasedOn="{StaticResource ModernTextBox}">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="8,0"/>
                <Setter Property="MinHeight" Value="40"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
            </Style>
            <Style x:Key="SearchComboBox" TargetType="ComboBox" BasedOn="{StaticResource ModernComboBox}">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="8,0"/>
                <Setter Property="MinHeight" Value="40"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
            </Style>

            <!-- Material Design alanlarında metnin kırpılmasını önleyen varsayılan ölçüler -->
            <Style TargetType="TextBox" BasedOn="{StaticResource ModernTextBox}"/>
            <Style TargetType="ComboBox" BasedOn="{StaticResource ModernComboBox}"/>

        </ResourceDictionary>
    </Application.Resources>
</Application>
