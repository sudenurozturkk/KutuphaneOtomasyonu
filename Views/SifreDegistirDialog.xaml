<Window x:Class="KutuphaneOtomasyonu.Views.SifreDegistirDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Şifre Değiştir" SizeToContent="Height" Width="440"
        WindowStartupLocation="CenterOwner" WindowStyle="None"
        AllowsTransparency="True" Background="Transparent"
        MouseLeftButtonDown="Window_MouseDown">
    <Border Background="#0F172A" CornerRadius="16" BorderBrush="#334155" BorderThickness="1" Padding="24">
        <StackPanel>
            <Grid Margin="0,0,0,16">
                <TextBlock Text="Şifre Değiştir" FontSize="18" FontWeight="Bold" Foreground="White"/>
                <Button Style="{StaticResource MaterialDesignIconButton}" Width="32" Height="32"
                        HorizontalAlignment="Right" Foreground="#94A3B8" Click="BtnKapat_Click">
                    <materialDesign:PackIcon Kind="Close" Width="18" Height="18"/>
                </Button>
            </Grid>
            <TextBlock Text="Mevcut şifre *" Foreground="#94A3B8" Margin="0,0,0,4"/>
            <PasswordBox x:Name="txtMevcut" Foreground="White" Margin="0,0,0,14"/>
            <TextBlock x:Name="txtYeniEtiket" Text="Yeni şifre *" Foreground="#94A3B8" Margin="0,0,0,4"/>
            <PasswordBox x:Name="txtYeni" Foreground="White" Margin="0,0,0,14"/>
            <TextBlock Text="Yeni şifre (tekrar) *" Foreground="#94A3B8" Margin="0,0,0,4"/>
            <PasswordBox x:Name="txtYeniTekrar" Foreground="White" Margin="0,0,0,10"/>
            <TextBlock x:Name="txtHata" Foreground="#F87171" TextWrapping="Wrap" Visibility="Collapsed" Margin="0,0,0,10"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="İptal" Width="100" Height="40" Margin="0,0,12,0"
                        Style="{StaticResource MaterialDesignOutlinedButton}" Click="BtnKapat_Click"/>
                <Button x:Name="btnKaydet" Content="Şifreyi Değiştir" Width="150" Height="40"
                        Background="#2563EB" Foreground="White" FontWeight="SemiBold"
                        Click="BtnKaydet_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
