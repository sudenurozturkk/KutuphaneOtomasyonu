<Page x:Class="KutuphaneOtomasyonu.Views.Pages.BarkodBankoPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      Background="#0B1120">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Başlık -->
        <StackPanel Grid.Row="0" Margin="0,0,0,24">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="🏢 Hızlı Barkod &amp; Ödünç Bankosu" FontSize="22" FontWeight="Bold"
                           Foreground="White" FontFamily="Segoe UI"/>
                <Border Background="#1E293B" CornerRadius="8" Padding="10,4" Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="⚡ Hızlı İşlem Terminali" FontSize="12" Foreground="#10B981" FontWeight="SemiBold"/>
                </Border>
            </StackPanel>
            <TextBlock Text="Barkod / ISBN okutarak veya elle girerek tek tuşla anında ödünç verin veya iade alın."
                       FontSize="13" Foreground="#94A3B8" Margin="0,6,0,0"/>
        </StackPanel>

        <!-- Banko Grid -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="420"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Sol: Barkod Tarama & İşlem Paneli -->
            <Border Grid.Column="0" Background="#0F172A" CornerRadius="16" BorderBrush="#1E293B" BorderThickness="1"
                    Padding="24" Margin="0,0,20,0">
                <StackPanel>
                    <TextBlock Text="📷 Barkod / ISBN Girişi" FontSize="16" FontWeight="Bold" Foreground="White" Margin="0,0,0,16"/>

                    <TextBlock Text="Kitap Barkodu / ISBN *" Foreground="#94A3B8" FontSize="13" Margin="0,0,0,6"/>
                    <Grid Margin="0,0,0,16">
                        <TextBox x:Name="txtBarkod" Foreground="White" FontSize="15"
                                 Style="{StaticResource ModernTextBox}"
                                 materialDesign:HintAssist.Hint="Örn: 9789750719387 veya Kitap ID"
                                 KeyDown="TxtBarkod_KeyDown"/>
                    </Grid>

                    <TextBlock Text="Üye No / T.C. Kimlik / Öğrenci No *" Foreground="#94A3B8" FontSize="13" Margin="0,0,0,6"/>
                    <TextBox x:Name="txtUyeNo" Foreground="White" FontSize="15"
                             Style="{StaticResource ModernTextBox}"
                             materialDesign:HintAssist.Hint="Örn: 20240101 veya 10000000001"
                             Margin="0,0,0,20" KeyDown="TxtUyeNo_KeyDown"/>

                    <!-- Hızlı İşlem Butonları -->
                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" Height="48" Margin="0,0,6,0"
                                FontWeight="Bold" FontSize="14" Foreground="White"
                                materialDesign:ButtonAssist.CornerRadius="12" x:Name="btnHizliOdunc" AutomationProperties.Name="Ödünç Ver" Click="BtnHizliOdunc_Click">
                            <Button.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#2563EB" Offset="0"/>
                                    <GradientStop Color="#3B82F6" Offset="1"/>
                                </LinearGradientBrush>
                            </Button.Background>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="BookArrowRight" Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="Ödünç Ver" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Grid.Column="1" Height="48" Margin="6,0,0,0"
                                FontWeight="Bold" FontSize="14" Foreground="White"
                                materialDesign:ButtonAssist.CornerRadius="12" x:Name="btnHizliIade" AutomationProperties.Name="İade Al" Click="BtnHizliIade_Click">
                            <Button.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#059669" Offset="0"/>
                                    <GradientStop Color="#10B981" Offset="1"/>
                                </LinearGradientBrush>
                            </Button.Background>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="BookCheck" Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="İade Al" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- Hızlı Örnek Barkodlar -->
                    <Border Background="#1E293B" CornerRadius="12" Padding="14">
                        <StackPanel>
                            <TextBlock Text="💡 Hızlı Test Butonları (Tek Tıkla Doldur):" FontSize="12" Foreground="#94A3B8" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <WrapPanel>
                                <Button Content="Clean Code" Height="28" Padding="8,0" Margin="0,0,6,6"
                                        Style="{StaticResource MaterialDesignOutlinedButton}" FontSize="11" Click="QuickFill_CleanCode"/>
                                <Button Content="Algoritmalar" Height="28" Padding="8,0" Margin="0,0,6,6"
                                        Style="{StaticResource MaterialDesignOutlinedButton}" FontSize="11" Click="QuickFill_Algo"/>
                                <Button Content="Ahmet Yılmaz (Üye)" Height="28" Padding="8,0" Margin="0,0,6,6"
                                        Style="{StaticResource MaterialDesignOutlinedButton}" FontSize="11" Click="QuickFill_Member"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Sağ: Canlı Terminal İşlem Kayıtları (Log / Fiş) -->
            <Border Grid.Column="1" Background="#0F172A" CornerRadius="16" BorderBrush="#1E293B" BorderThickness="1" Padding="24">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <TextBlock Text="📋 Terminal İşlem Fişi &amp; Canlı Akış" FontSize="16" FontWeight="Bold" Foreground="White"/>
                        <Button HorizontalAlignment="Right" Content="Temizle" Style="{StaticResource MaterialDesignFlatButton}"
                                Foreground="#94A3B8" FontSize="12" Click="BtnTemizleLog_Click"/>
                    </Grid>

                    <Border Grid.Row="1" Background="#060913" CornerRadius="12" BorderBrush="#1E293B" BorderThickness="1" Padding="16">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <TextBox x:Name="txtTerminalLog" Background="Transparent" BorderThickness="0"
                                     Foreground="#10B981" FontFamily="Consolas, Fira Code, Segoe UI" FontSize="13"
                                     IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"/>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
