<Window x:Class="KutuphaneOtomasyonu.Views.Pages.AkademikYayinEkleDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Yeni Tez / Makale" Height="620" Width="560"
        WindowStartupLocation="CenterOwner" WindowStyle="None"
        AllowsTransparency="True" Background="Transparent"
        MouseLeftButtonDown="Window_MouseDown">
    <Border Background="#0F172A" CornerRadius="16" BorderBrush="#334155" BorderThickness="1" Padding="24">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Grid Margin="0,0,0,20">
                    <TextBlock Text="Yeni Tez / Makale" FontSize="18" FontWeight="Bold" Foreground="White"/>
                    <Button Style="{StaticResource MaterialDesignIconButton}" Width="32" Height="32"
                            HorizontalAlignment="Right" Foreground="#94A3B8" Click="BtnKapat_Click">
                        <materialDesign:PackIcon Kind="Close" Width="18" Height="18"/>
                    </Button>
                </Grid>
                <TextBlock Text="Başlık *" Foreground="#94A3B8" Margin="0,0,0,4"/>
                <TextBox x:Name="txtBaslik" Style="{StaticResource ModernTextBox}" Margin="0,0,0,12"/>
                <TextBlock Text="Yazar *" Foreground="#94A3B8" Margin="0,0,0,4"/>
                <TextBox x:Name="txtYazar" Style="{StaticResource ModernTextBox}" Margin="0,0,0,12"/>
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Yayın türü *" Foreground="#94A3B8" Margin="0,0,0,4"/>
                        <ComboBox x:Name="cbTur" Style="{StaticResource ModernComboBox}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Kampüs" Foreground="#94A3B8" Margin="0,0,0,4"/>
                        <ComboBox x:Name="cbKampus" Style="{StaticResource ModernComboBox}"/>
                    </StackPanel>
                </Grid>
                <TextBlock Text="Danışman" Foreground="#94A3B8" Margin="0,0,0,4"/>
                <TextBox x:Name="txtDanisman" Style="{StaticResource ModernTextBox}" Margin="0,0,0,12"/>
                <TextBlock Text="DOI" Foreground="#94A3B8" Margin="0,0,0,4"/>
                <TextBox x:Name="txtDoi" Style="{StaticResource ModernTextBox}" Margin="0,0,0,12"/>
                <TextBlock Text="Özet" Foreground="#94A3B8" Margin="0,0,0,4"/>
                <TextBox x:Name="txtOzet" Style="{StaticResource ModernTextBox}" Height="90"
                         TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top"
                         Margin="0,0,0,20"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="İptal" Width="100" Height="40" Margin="0,0,12,0"
                            Style="{StaticResource MaterialDesignOutlinedButton}" Click="BtnKapat_Click"/>
                    <Button Content="Kaydet" Width="120" Height="40" Background="#2563EB"
                            Foreground="White" FontWeight="SemiBold" Click="BtnKaydet_Click"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Border>
</Window>
