<Window x:Class="KutuphaneOtomasyonu.Views.Pages.KitapDetayDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Kitap Detayı" Height="550" Width="500"
        WindowStartupLocation="CenterOwner" WindowStyle="None"
        AllowsTransparency="True" Background="Transparent"
        MouseLeftButtonDown="Window_MouseDown">
    <Border Background="#0F172A" CornerRadius="16" BorderBrush="#334155" BorderThickness="1" Padding="24">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,16">
                <TextBlock Text="📖 Kitap Detayı" FontSize="18" FontWeight="Bold"
                           Foreground="White" FontFamily="Segoe UI" VerticalAlignment="Center"/>
                <Button Style="{StaticResource MaterialDesignIconButton}" Width="32" Height="32"
                        HorizontalAlignment="Right" Foreground="#94A3B8" Click="BtnKapat_Click">
                    <materialDesign:PackIcon Kind="Close" Width="18" Height="18"/>
                </Button>
            </Grid>

            <ScrollViewer Grid.Row="1">
                <StackPanel>
                    <TextBlock x:Name="txtBaslik" Text="Kitap Başlığı" FontSize="20" FontWeight="Bold"
                               Foreground="White" Margin="0,0,0,4"/>
                    <TextBlock x:Name="txtYazar" Text="Yazar Adı" FontSize="15"
                               Foreground="#3B82F6" Margin="0,0,0,16"/>

                    <Border Background="#1E293B" CornerRadius="12" Padding="16" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock x:Name="txtISBN" Text="ISBN: -" Foreground="#94A3B8" Margin="0,0,0,6"/>
                            <TextBlock x:Name="txtKategori" Text="Kategori: -" Foreground="#94A3B8" Margin="0,0,0,6"/>
                            <TextBlock x:Name="txtYayinevi" Text="Yayınevi: -" Foreground="#94A3B8" Margin="0,0,0,6"/>
                            <TextBlock x:Name="txtRaf" Text="Raf Konumu: -" Foreground="#94A3B8" Margin="0,0,0,6"/>
                            <TextBlock x:Name="txtStok" Text="Mevcut Stok: - / -" Foreground="#14B8A6" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Nüshalar" FontSize="14" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,6"/>
                    <ItemsControl x:Name="icNushalar" Margin="0,0,0,16">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="130"/>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Barkod}" Foreground="White" FontFamily="Consolas"/>
                                    <TextBlock Grid.Column="1" Text="{Binding RafKonumu}" Foreground="#94A3B8"/>
                                    <TextBlock Grid.Column="2" Text="{Binding DurumMetni}" Foreground="#94A3B8"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="Açıklama" FontSize="14" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,6"/>
                    <TextBlock x:Name="txtAciklama" Text="Açıklama bulunmuyor." Foreground="#94A3B8" TextWrapping="Wrap"/>
                </StackPanel>
            </ScrollViewer>

            <Button Grid.Row="2" Content="Kapat" Width="100" Height="38" Margin="0,16,0,0"
                    HorizontalAlignment="Right" Foreground="#94A3B8"
                    Style="{StaticResource MaterialDesignOutlinedButton}" Click="BtnKapat_Click"/>
        </Grid>
    </Border>
</Window>
