<Page x:Class="KutuphaneOtomasyonu.Views.Pages.MimariUmlPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      Background="#080C18">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,24,28,32">

            <!-- Başlık -->
            <Grid Margin="0,0,0,24">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="40" Height="40" CornerRadius="12" Margin="0,0,14,0">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#6366F1" Offset="0"/>
                                    <GradientStop Color="#A855F7" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <materialDesign:PackIcon Kind="ChartBubble" Width="22" Height="22"
                                                     Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel>
                            <TextBlock Text="Canlı Mimari &amp; UML Müfettişi" FontSize="24" FontWeight="Bold"
                                       Foreground="White" FontFamily="Segoe UI"/>
                            <TextBlock Text="Yazılım Tasarım Mimarisi • Kurumsal OOP &amp; Tasarım Desenleri Denetleyicisi"
                                       FontSize="13" Foreground="#94A3B8" FontFamily="Segoe UI" Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <!-- Sağ Canlı Durum Rozeti -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Border Background="#0F172A" CornerRadius="12" Padding="14,8" BorderBrush="#1E293B" BorderThickness="1" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Fill="#10B981" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="Mimari: %100 Uyumlu" FontSize="12" FontWeight="SemiBold" Foreground="#34D399"/>
                        </StackPanel>
                    </Border>
                    <Button x:Name="btnBellekTopla" Style="{StaticResource MaterialDesignOutlinedButton}"
                            BorderBrush="#6366F1" Foreground="#818CF8" Height="36" Padding="12,0"
                            materialDesign:ButtonAssist.CornerRadius="10" Click="BtnBellekTopla_Click">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Memory" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="Belleği Optimize Et (GC)" FontSize="12"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- 4 Mimari Özet KPI Kartı -->
            <UniformGrid Columns="4" Margin="0,0,0,24">
                <!-- Katmanlar -->
                <Border Margin="0,0,8,0" Background="#0F172A" CornerRadius="16" Padding="18" BorderBrush="#1E293B" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="KATMANLI MİMARİ" FontSize="11" FontWeight="Bold" Foreground="#64748B"/>
                        <TextBlock Text="4 Katman" FontSize="24" FontWeight="Bold" Foreground="#38BDF8" Margin="0,6,0,2"/>
                        <TextBlock Text="UI • Service • Domain • Data" FontSize="12" Foreground="#94A3B8"/>
                    </StackPanel>
                </Border>

                <!-- Tasarım Desenleri -->
                <Border Margin="4,0" Background="#0F172A" CornerRadius="16" Padding="18" BorderBrush="#1E293B" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="GOF TASARIM DESENLERİ" FontSize="11" FontWeight="Bold" Foreground="#64748B"/>
                        <TextBlock Text="5 Aktif Desen" FontSize="24" FontWeight="Bold" Foreground="#A855F7" Margin="0,6,0,2"/>
                        <TextBlock Text="Singleton, Repo, Factory, Strat, Obs" FontSize="12" Foreground="#94A3B8"/>
                    </StackPanel>
                </Border>

                <!-- Sınıf Sayısı -->
                <Border Margin="4,0" Background="#0F172A" CornerRadius="16" Padding="18" BorderBrush="#1E293B" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="DOMAIN &amp; ENTITY MODELİ" FontSize="11" FontWeight="Bold" Foreground="#64748B"/>
                        <TextBlock Text="12+ Sınıf" FontSize="24" FontWeight="Bold" Foreground="#34D399" Margin="0,6,0,2"/>
                        <TextBlock Text="Kalıtım, Çok Biçimlilik &amp; Çokluklar" FontSize="12" Foreground="#94A3B8"/>
                    </StackPanel>
                </Border>

                <!-- Canlı Bellek & SQLite -->
                <Border Margin="8,0,0,0" Background="#0F172A" CornerRadius="16" Padding="18" BorderBrush="#1E293B" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="VERİTABANI &amp; BELLEK" FontSize="11" FontWeight="Bold" Foreground="#64748B"/>
                        <TextBlock x:Name="txtCanliBellek" Text="~45 MB" FontSize="24" FontWeight="Bold" Foreground="#F59E0B" Margin="0,6,0,2"/>
                        <TextBlock Text="SQLite EF Core • 100% Bağlı" FontSize="12" Foreground="#94A3B8"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Sekmeli Mimari Detay Alanı -->
            <Border Background="#0F172A" CornerRadius="16" BorderBrush="#1E293B" BorderThickness="1" Padding="20">
                <TabControl Background="Transparent" BorderThickness="0">

                    <!-- Sekme 1: Paket & Katman Mimarisi -->
                    <TabItem Header="🏛️ Katman Mimarisi (Package Diagram)" FontSize="13" Foreground="White">
                        <StackPanel Margin="10,20,10,10">
                            <TextBlock Text="Sistem Gevşek Bağlı (Loosely Coupled) ve Yüksek Uyumlu (High Cohesion) 4 Mantıksal Katmandan Oluşur:"
                                       FontSize="13" Foreground="#94A3B8" Margin="0,0,0,20"/>

                            <UniformGrid Columns="2">
                                <!-- Presentation Layer -->
                                <Border Margin="0,0,10,14" Background="#162033" CornerRadius="14" Padding="18" BorderBrush="#2563EB" BorderThickness="1">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                            <Border Background="#2563EB" CornerRadius="8" Padding="8,4" Margin="0,0,10,0">
                                                <TextBlock Text="UI KATMANI" FontSize="11" FontWeight="Bold" Foreground="White"/>
                                            </Border>
                                            <TextBlock Text="Presentation Layer (WPF XAML)" FontSize="15" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock Text="Kullanıcı arayüzü, görsel etkileşimler, sayfalar ve diyaloglar:" FontSize="12" Foreground="#94A3B8" Margin="0,0,0,8"/>
                                        <TextBlock Text="• LoginWindow, MainWindow&#x0a;• DashboardPage, KitaplarPage, OdunclerPage, UyelerPage&#x0a;• SalonRezervasyonPage (2D Kat Planı), CuzdanPage (Akıllı Kart)&#x0a;• EKitapPage (Okuyucu), BarkodBankoPage, RaporlarPage"
                                                   FontFamily="Consolas" FontSize="12" Foreground="#93C5FD"/>
                                    </StackPanel>
                                </Border>

                                <!-- Service Layer -->
                                <Border Margin="10,0,0,14" Background="#162033" CornerRadius="14" Padding="18" BorderBrush="#7C3AED" BorderThickness="1">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                            <Border Background="#7C3AED" CornerRadius="8" Padding="8,4" Margin="0,0,10,0">
                                                <TextBlock Text="İŞ MANTIĞI" FontSize="11" FontWeight="Bold" Foreground="White"/>
                                            </Border>
                                            <TextBlock Text="Service &amp; Business Logic Layer" FontSize="15" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock Text="İş kuralları, ceza hesaplama, rezervasyon doğrulama servisleri:" FontSize="12" Foreground="#94A3B8" Margin="0,0,0,8"/>
                                        <TextBlock Text="• AuthService (Singleton oturum denetleyicisi)&#x0a;• KitapService &amp; UyeService (CRUD ve filtreleme kuralları)&#x0a;• OduncService (Ödünç alma, iade ve süre uzatma kuralları)&#x0a;• BildirimService (Kuyruk ve olay dinleyicisi)"
                                                   FontFamily="Consolas" FontSize="12" Foreground="#C4B5FD"/>
                                    </StackPanel>
                                </Border>

                                <!-- Domain & Entities -->
                                <Border Margin="0,0,10,0" Background="#162033" CornerRadius="14" Padding="18" BorderBrush="#059669" BorderThickness="1">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                            <Border Background="#059669" CornerRadius="8" Padding="8,4" Margin="0,0,10,0">
                                                <TextBlock Text="DOMAİN" FontSize="11" FontWeight="Bold" Foreground="White"/>
                                            </Border>
                                            <TextBlock Text="Domain Entities &amp; OOP Models" FontSize="15" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock Text="Kalıtım, arayüzler ve nesne tabanlı iş varlıkları:" FontSize="12" Foreground="#94A3B8" Margin="0,0,0,8"/>
                                        <TextBlock Text="• Kullanici (Abstract Base) &lt;|-- Ogrenci, Akademisyen, Kutuphaneci&#x0a;• Materyal &lt;|-- Kitap, EKitap, Dergi&#x0a;• OduncIslemi, Rezervasyon, CezaKaydi, RafKonumu&#x0a;• Polimorfik MaksimumOduncSayisi() &amp; OduncSuresiGun()"
                                                   FontFamily="Consolas" FontSize="12" Foreground="#6EE7B7"/>
                                    </StackPanel>
                                </Border>

                                <!-- Data & Persistence -->
                                <Border Margin="10,0,0,0" Background="#162033" CornerRadius="14" Padding="18" BorderBrush="#D97706" BorderThickness="1">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                            <Border Background="#D97706" CornerRadius="8" Padding="8,4" Margin="0,0,10,0">
                                                <TextBlock Text="VERİ KATMANI" FontSize="11" FontWeight="Bold" Foreground="White"/>
                                            </Border>
                                            <TextBlock Text="Data Access &amp; Persistence (EF Core)" FontSize="15" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock Text="Kalıcı veri depolama, ORM eşleme ve seed mekanizması:" FontSize="12" Foreground="#94A3B8" Margin="0,0,0,8"/>
                                        <TextBlock Text="• KutuphaneDbContext (Entity Framework Core SQLite)&#x0a;• DatabaseSeeder (Otomatik başlangıç verisi üretici)&#x0a;• LINQ sorguları ile optimize edilmiş asenkron veri erişimi&#x0a;• İlişkisel Foreign Key ve Cascade kuralları"
                                                   FontFamily="Consolas" FontSize="12" Foreground="#FCD34D"/>
                                    </StackPanel>
                                </Border>
                            </UniformGrid>
                        </StackPanel>
                    </TabItem>

                    <!-- Sekme 2: Tasarım Desenleri (GoF Design Patterns) -->
                    <TabItem Header="⚡ Tasarım Desenleri (GoF Patterns)" FontSize="13" Foreground="White">
                        <StackPanel Margin="10,20,10,10">
                            <TextBlock Text="Projeye Entegre Edilmiş Kurumsal Yazılım Tasarım Desenleri (Design Patterns):"
                                       FontSize="13" Foreground="#94A3B8" Margin="0,0,0,20"/>

                            <StackPanel>
                                <!-- Singleton Pattern -->
                                <Border Background="#162033" CornerRadius="14" Padding="16" Margin="0,0,0,12" BorderBrush="#3B82F6" BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="220"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="140"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="1. Singleton Pattern" FontSize="15" FontWeight="Bold" Foreground="#38BDF8"/>
                                            <TextBlock Text="AuthService.Instance" FontFamily="Consolas" FontSize="12" Foreground="#94A3B8" Margin="0,4,0,0"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="Tüm uygulama yaşam döngüsünde tek bir aktif kullanıcı ve yetkilendirme örneği tutulmasını sağlar. Thread-safe Lazy başlatma kullanılır."
                                                   FontSize="12" Foreground="#E2E8F0" TextWrapping="Wrap" VerticalAlignment="Center" Margin="10,0"/>
                                        <Border Grid.Column="2" Background="#1E293B" CornerRadius="8" Padding="10,4" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <TextBlock Text="Yaratımsal (Creational)" FontSize="11" Foreground="#38BDF8"/>
                                        </Border>
                                    </Grid>
                                </Border>

                                <!-- Repository Pattern -->
                                <Border Background="#162033" CornerRadius="14" Padding="16" Margin="0,0,0,12" BorderBrush="#8B5CF6" BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="220"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="140"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="2. Repository Pattern" FontSize="15" FontWeight="Bold" Foreground="#A855F7"/>
                                            <TextBlock Text="KitapService, UyeService" FontFamily="Consolas" FontSize="12" Foreground="#94A3B8" Margin="0,4,0,0"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="Veri tabanı erişim detaylarını UI katmanından tamamen izole eder. İş katmanı doğrudan SQL yerine servis metodları üzerinden veri çeker."
                                                   FontSize="12" Foreground="#E2E8F0" TextWrapping="Wrap" VerticalAlignment="Center" Margin="10,0"/>
                                        <Border Grid.Column="2" Background="#1E293B" CornerRadius="8" Padding="10,4" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <TextBlock Text="Yapısal (Structural)" FontSize="11" Foreground="#A855F7"/>
                                        </Border>
                                    </Grid>
                                </Border>

                                <!-- Factory Pattern -->
                                <Border Background="#162033" CornerRadius="14" Padding="16" Margin="0,0,0,12" BorderBrush="#10B981" BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="220"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="140"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="3. Factory Pattern" FontSize="15" FontWeight="Bold" Foreground="#34D399"/>
                                            <TextBlock Text="MateryalFabrikasi" FontFamily="Consolas" FontSize="12" Foreground="#94A3B8" Margin="0,4,0,0"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="Kitap, E-Kitap veya Dergi gibi farklı kütüphane materyallerini tek bir arayüzden parametrik olarak üretir, nesne yaratım bağımlılığını çözer."
                                                   FontSize="12" Foreground="#E2E8F0" TextWrapping="Wrap" VerticalAlignment="Center" Margin="10,0"/>
                                        <Border Grid.Column="2" Background="#1E293B" CornerRadius="8" Padding="10,4" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <TextBlock Text="Yaratımsal (Creational)" FontSize="11" Foreground="#34D399"/>
                                        </Border>
                                    </Grid>
                                </Border>

                                <!-- Strategy Pattern -->
                                <Border Background="#162033" CornerRadius="14" Padding="16" Margin="0,0,0,12" BorderBrush="#F59E0B" BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="220"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="140"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="4. Strategy Pattern" FontSize="15" FontWeight="Bold" Foreground="#FBBF24"/>
                                            <TextBlock Text="Ceza &amp; Sure Stratejisi" FontFamily="Consolas" FontSize="12" Foreground="#94A3B8" Margin="0,4,0,0"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="Kullanıcının unvanına (Öğrenci, Doktora, Akademisyen) göre ödünç süresi, uzatma hakkı ve gecikme cezası katsayılarını dinamik olarak belirler."
                                                   FontSize="12" Foreground="#E2E8F0" TextWrapping="Wrap" VerticalAlignment="Center" Margin="10,0"/>
                                        <Border Grid.Column="2" Background="#1E293B" CornerRadius="8" Padding="10,4" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <TextBlock Text="Davranışsal (Behavioral)" FontSize="11" Foreground="#FBBF24"/>
                                        </Border>
                                    </Grid>
                                </Border>

                                <!-- Observer Pattern -->
                                <Border Background="#162033" CornerRadius="14" Padding="16" BorderBrush="#EC4899" BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="220"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="140"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="5. Observer Pattern" FontSize="15" FontWeight="Bold" Foreground="#F472B6"/>
                                            <TextBlock Text="BildirimServisi &amp; Olaylar" FontFamily="Consolas" FontSize="12" Foreground="#94A3B8" Margin="0,4,0,0"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="Ödünç süresi yaklaştığında veya geciktiğinde ilgili kullanıcı ve kütüphaneciye otomatik bildirim yayınlar (Event-Driven Notification)."
                                                   FontSize="12" Foreground="#E2E8F0" TextWrapping="Wrap" VerticalAlignment="Center" Margin="10,0"/>
                                        <Border Grid.Column="2" Background="#1E293B" CornerRadius="8" Padding="10,4" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <TextBlock Text="Davranışsal (Behavioral)" FontSize="11" Foreground="#F472B6"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </TabItem>

                    <!-- Sekme 3: Sınıf Şeması & Çokluklar (Class Diagram) -->
                    <TabItem Header="📊 Sınıf Şeması &amp; Çokluklar (UML)" FontSize="13" Foreground="White">
                        <StackPanel Margin="10,20,10,10">
                            <TextBlock Text="Nesne Tabanlı Hiyerarşi, Kalıtım (Inheritance), Kompozisyon ve Çokluklar (Multiplicities):"
                                       FontSize="13" Foreground="#94A3B8" Margin="0,0,0,16"/>

                            <Border Background="#080C18" CornerRadius="12" Padding="20" BorderBrush="#1E293B" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="[KULLANICI HİYERARŞİSİ]" FontSize="13" FontWeight="Bold" Foreground="#38BDF8" Margin="0,0,0,8"/>
                                    <TextBlock Text="Kullanici (Soyut Sınıf / Abstract)&#x0a;  ├── Ogrenci (Maks: 3 Kitap, Süre: 15 Gün, Bakiye: ₺150)&#x0a;  ├── Akademisyen (Maks: 10 Kitap, Süre: 60 Gün, Özel Oda)&#x0a;  └── Kutuphaneci (Materyal Yönetimi, Barkod Bankosu Yetkisi)"
                                               FontFamily="Consolas" FontSize="13" Foreground="#E2E8F0" Margin="0,0,0,16"/>

                                    <TextBlock Text="[İLİŞKİLER VE ÇOKLUKLAR (MULTIPLICITIES)]" FontSize="13" FontWeight="Bold" Foreground="#34D399" Margin="0,0,0,8"/>
                                    <TextBlock Text="• Uye (1) &lt;-------- (0..*) OduncIslemi  [Bir üyenin sıfır veya birden fazla ödünç kaydı olabilir]&#x0a;• Kitap (1) &lt;------ (0..*) OduncIslemi  [Bir kitabın geçmişte birden çok ödünç kaydı bulunur]&#x0a;• Kitap (1) &lt;------ (1) RafKonumu      [Her basılı kitabın kütüphanede tekil bir raf adresi vardır]&#x0a;• Uye (1) &lt;-------- (0..*) Rezervasyon  [Bir üye birden fazla salon masası veya kitap rezerve edebilir]&#x0a;• Uye (1) &lt;-------- (0..*) CezaKaydi    [Borçlu üyelerin gecikme kayıtları cüzdan ile ilişkilidir]"
                                               FontFamily="Consolas" FontSize="13" Foreground="#E2E8F0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </TabItem>

                </TabControl>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
