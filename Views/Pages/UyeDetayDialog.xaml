<Window x:Class="KutuphaneOtomasyonu.Views.Pages.UyeDetayDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Üye Detayı" Height="500" Width="480"
        WindowStartupLocation="CenterOwner" WindowStyle="None"
        AllowsTransparency="True" Background="Transparent"
        MouseLeftButtonDown="Window_MouseDown">
    <Border Background="#0F172A" CornerRadius="16" BorderBrush="#334155" BorderThickness="1" Padding="24">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,16">
                <TextBlock Text="👤 Üye Profili" FontSize="18" FontWeight="Bold"
                           Foreground="White" FontFamily="Segoe UI" VerticalAlignment="Center"/>
                <Button Style="{StaticResource MaterialDesignIconButton}" Width="32" Height="32"
                        HorizontalAlignment="Right" Foreground="#94A3B8" Click="BtnKapat_Click">
                    <materialDesign:PackIcon Kind="Close" Width="18" Height="18"/>
                </Button>
            </Grid>

            <ScrollViewer Grid.Row="1">
                <StackPanel>
                    <TextBlock x:Name="txtTamAd" Text="Üye Adı Soyadı" FontSize="20" FontWeight="Bold"
                               Foreground="White" Margin="0,0,0,4"/>
                    <TextBlock x:Name="txtUyeTipi" Text="Öğrenci" FontSize="14"
                               Foreground="#8B5CF6" Margin="0,0,0,16"/>

                    <Border Background="#1E293B" CornerRadius="12" Padding="16" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock x:Name="txtTC" Text="TC: -" Foreground="#94A3B8" Margin="0,0,0,6"/>
                            <TextBlock x:Name="txtPasaport" Text="Pasaport: -" Foreground="#94A3B8" Margin="0,0,0,6"/>
                            <TextBlock x:Name="txtEmail" Text="E-Posta: -" Foreground="#94A3B8" Margin="0,0,0,6"/>
                            <TextBlock x:Name="txtTelefon" Text="Telefon: -" Foreground="#94A3B8" Margin="0,0,0,6"/>
                            <TextBlock x:Name="txtOgrenciNo" Text="Öğrenci No: -" Foreground="#94A3B8" Margin="0,0,0,6"/>
                            <TextBlock x:Name="txtBolum" Text="Bölüm / Fakülte: -" Foreground="#94A3B8" Margin="0,0,0,6"/>
                            <TextBlock x:Name="txtDurum" Text="Durum: Aktif" Foreground="#10B981" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>
                    <TextBlock x:Name="txtMaskeBilgi" Visibility="Collapsed" FontSize="11" Foreground="#64748B" TextWrapping="Wrap"
                               Text="Kişisel veriler rolünüz gereği kısmen gizlenmiştir (KVKK veri minimizasyonu)."/>
                </StackPanel>
            </ScrollViewer>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button x:Name="btnPortalSifresi" Content="Portal Hesabı Aç" Height="38" Padding="14,0" Margin="0,0,12,0"
                        Style="{StaticResource MaterialDesignOutlinedButton}" Click="BtnPortalSifresi_Click"/>
                <Button x:Name="btnAnonimlestir" Content="KVKK: Anonimleştir" Height="38" Padding="14,0" Margin="0,0,12,0"
                        Visibility="Collapsed" Foreground="#F87171" BorderBrush="#F87171"
                        Style="{StaticResource MaterialDesignOutlinedButton}" Click="BtnAnonimlestir_Click"/>
                <Button Content="Kapat" Width="100" Height="38" Foreground="#94A3B8"
                        Style="{StaticResource MaterialDesignOutlinedButton}" Click="BtnKapat_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
