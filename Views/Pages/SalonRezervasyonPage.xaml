<Page x:Class="KutuphaneOtomasyonu.Views.Pages.SalonRezervasyonPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      Background="#0B1120">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Başlık ve Filtre / Durum Açıklaması -->
        <Grid Grid.Row="0" Margin="0,0,0,24">
            <StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🪑 2D Salon &amp; Masa Rezervasyonu" FontSize="22" FontWeight="Bold"
                               Foreground="White" FontFamily="Segoe UI"/>
                    <Border Background="#1E293B" CornerRadius="8" Padding="10,4" Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="txtSalonDurum" Text="Kat 1 - Ana Çalışma Salonu (16/24 Masa Müsait)"
                                   FontSize="12" Foreground="#38BDF8" FontWeight="SemiBold"/>
                    </Border>
                </StackPanel>
                <TextBlock Text="Kütüphane çalışma salonundan masa seçin ve anında adınıza rezerve edin."
                           FontSize="13" Foreground="#94A3B8" Margin="0,6,0,0"/>
            </StackPanel>

            <!-- Renk Legend'ı -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Border Width="12" Height="12" CornerRadius="6" Background="#10B981" Margin="0,0,6,0"/>
                <TextBlock Text="Boş (Müsait)" Foreground="#94A3B8" FontSize="12" Margin="0,0,16,0" VerticalAlignment="Center"/>

                <Border Width="12" Height="12" CornerRadius="6" Background="#EF4444" Margin="0,0,6,0"/>
                <TextBlock Text="Dolu" Foreground="#94A3B8" FontSize="12" Margin="0,0,16,0" VerticalAlignment="Center"/>

                <Border Width="12" Height="12" CornerRadius="6" Background="#F59E0B" Margin="0,0,6,0"/>
                <TextBlock Text="Rezerve" Foreground="#94A3B8" FontSize="12" Margin="0,0,16,0" VerticalAlignment="Center"/>

                <Border Width="12" Height="12" CornerRadius="6" Background="#3B82F6" Margin="0,0,6,0"/>
                <TextBlock Text="Seçili" Foreground="#94A3B8" FontSize="12" VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- Kat Planı ve Masa Detay Kartı (2 Kolon) -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="340"/>
            </Grid.ColumnDefinitions>

            <!-- Sol: Kat Planı Haritası -->
            <Border Grid.Column="0" Background="#0F172A" CornerRadius="16" BorderBrush="#1E293B" BorderThickness="1"
                    Padding="24" Margin="0,0,20,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- Bölüm 1: Sessiz Çalışma Alanı -->
                        <TextBlock Text="🤫 Sessiz Çalışma Alanı (Prizli &amp; Pencere Kenarı)" FontSize="15" FontWeight="SemiBold"
                                   Foreground="#38BDF8" Margin="0,0,0,12"/>
                        <WrapPanel x:Name="pnlSessizAlan" Margin="0,0,0,24"/>

                        <!-- Bölüm 2: Bireysel Çalışma Masaları -->
                        <TextBlock Text="💻 Bireysel Bilgisayar &amp; Çalışma Masaları" FontSize="15" FontWeight="SemiBold"
                                   Foreground="#A855F7" Margin="0,0,0,12"/>
                        <WrapPanel x:Name="pnlBireyselAlan" Margin="0,0,0,24"/>

                        <!-- Bölüm 3: Grup Çalışma Odaları -->
                        <TextBlock Text="👥 Grup Çalışma Odaları (Projeksiyon &amp; Akıllı Tahta)" FontSize="15" FontWeight="SemiBold"
                                   Foreground="#F59E0B" Margin="0,0,0,12"/>
                        <WrapPanel x:Name="pnlGrupAlan"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Sağ: Seçilen Masa Detayı ve Rezervasyon Formu -->
            <Border Grid.Column="1" Background="#0F172A" CornerRadius="16" BorderBrush="#1E293B" BorderThickness="1" Padding="24">
                <StackPanel>
                    <TextBlock Text="📌 Masa Bilgisi" FontSize="16" FontWeight="Bold" Foreground="White" Margin="0,0,0,16"/>

                    <Border Background="#1E293B" CornerRadius="14" Padding="18" Margin="0,0,0,20">
                        <StackPanel>
                            <Grid Margin="0,0,0,12">
                                <TextBlock x:Name="txtMasaKodu" Text="D-103" FontSize="24" FontWeight="Bold" Foreground="#38BDF8"/>
                                <Border x:Name="bdMasaDurum" HorizontalAlignment="Right" CornerRadius="8" Padding="10,4" Background="#10B981">
                                    <TextBlock x:Name="txtMasaDurumBadge" Text="BOŞ (MÜSAİT)" FontSize="11" FontWeight="Bold" Foreground="White"/>
                                </Border>
                            </Grid>

                            <TextBlock x:Name="txtMasaBolum" Text="Bölüm: Sessiz Çalışma Alanı" FontSize="13" Foreground="#94A3B8" Margin="0,0,0,6"/>
                            <TextBlock x:Name="txtMasaKapasite" Text="Kapasite: 1 Kişilik" FontSize="13" Foreground="#94A3B8" Margin="0,0,0,6"/>
                            <TextBlock x:Name="txtMasaOzellikler" Text="⚡ 220V Priz • 🪟 Pencere Kenarı • 📶 5GHz Wi-Fi" FontSize="12" Foreground="#38BDF8"/>
                        </StackPanel>
                    </Border>

                    <!-- Rezervasyon Yapma Formu -->
                    <TextBlock Text="Rezervasyon Süresi" FontSize="13" Foreground="#94A3B8" Margin="0,0,0,6"/>
                    <ComboBox x:Name="cbSure" SelectedIndex="1" Height="42" Foreground="White"
                              Style="{StaticResource MaterialDesignOutlinedComboBox}" Margin="0,0,0,16">
                        <ComboBoxItem Content="1 Saat (Hızlı Çalışma)"/>
                        <ComboBoxItem Content="2 Saat (Standart)"/>
                        <ComboBoxItem Content="4 Saat (Uzun Oturum)"/>
                        <ComboBoxItem Content="Tüm Gün (Akademik)"/>
                    </ComboBox>

                    <TextBlock Text="Rezervasyon Notu / Amaç" FontSize="13" Foreground="#94A3B8" Margin="0,0,0,6"/>
                    <TextBox x:Name="txtRezervNot" Height="42" Foreground="White"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             materialDesign:HintAssist.Hint="Örn: Tez çalışması, Final sınavı hazırlığı..."
                             Margin="0,0,0,24"/>

                    <Button x:Name="btnRezerveEt" Height="46" FontWeight="Bold" FontSize="14" Foreground="White"
                            materialDesign:ButtonAssist.CornerRadius="12" Click="BtnRezerveEt_Click">
                        <Button.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#0284C7" Offset="0"/>
                                <GradientStop Color="#0EA5E9" Offset="1"/>
                            </LinearGradientBrush>
                        </Button.Background>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="CheckCircleOutline" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="Masayı Şimdi Ayırt" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="btnIptalEt" Content="Rezervasyonu İptal Et / Masayı Boşalt" Height="40" Margin="0,10,0,0"
                            Style="{StaticResource MaterialDesignOutlinedButton}" Foreground="#EF4444"
                            BorderBrush="#EF4444" Click="BtnIptalEt_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
