<Page x:Class="KutuphaneOtomasyonu.Views.Pages.SalonRezervasyonPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      Background="#0B1120"
      FontFamily="Segoe UI">
    <Page.Resources>
        <Style x:Key="SectionCard" TargetType="Border">
            <Setter Property="Background" Value="#111B2E"/>
            <Setter Property="BorderBrush" Value="#22314A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="18"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>
        <Style x:Key="QuietText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#8190A8"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style x:Key="SlotText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#AAB7CB"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="FieldTextBox" TargetType="TextBox" BasedOn="{StaticResource ModernTextBox}">
            <Setter Property="MinHeight" Value="44"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Background" Value="#0B1425"/>
            <Setter Property="Foreground" Value="#F1F5F9"/>
            <Setter Property="BorderBrush" Value="#2A3A55"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="FieldComboBox" TargetType="ComboBox" BasedOn="{StaticResource ModernComboBox}">
            <Setter Property="MinHeight" Value="44"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Background" Value="#0B1425"/>
            <Setter Property="Foreground" Value="#F1F5F9"/>
            <Setter Property="BorderBrush" Value="#2A3A55"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Page.Resources>

    <Grid Margin="28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,22">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Rezervasyon merkezi" FontSize="27" FontWeight="SemiBold" Foreground="#F8FAFC"/>
                    <Border Background="#17304A" CornerRadius="5" Padding="8,4" Margin="12,4,0,0">
                        <TextBlock x:Name="txtSalonDurum" Text="16 / 24 müsait" Foreground="#7DD3FC" FontSize="11" FontWeight="SemiBold"/>
                    </Border>
                </StackPanel>
                <TextBlock Text="Çalışma alanlarını zaman dilimine göre görüntüleyin ve uygun masayı ayırtın."
                           Style="{StaticResource QuietText}" Margin="0,5,0,0"/>
            </StackPanel>
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                <StackPanel Margin="0,0,20,0" HorizontalAlignment="Right">
                    <TextBlock x:Name="txtSaat" Text="14:35" Foreground="#F8FAFC" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                    <TextBlock x:Name="txtTarih" Text="13 Ekim 2026" Style="{StaticResource QuietText}"/>
                </StackPanel>
                <Border Background="#122238" BorderBrush="#27415F" BorderThickness="1" CornerRadius="8" Padding="11,7">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="7" Height="7" Fill="#34D399" Margin="0,0,7,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Salon açık" Foreground="#B7F7DB" FontSize="11" FontWeight="SemiBold"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Background="#111B2E" BorderBrush="#22314A" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="2,0,18,0">
                    <materialDesign:PackIcon Kind="CalendarClock" Width="19" Height="19" Foreground="#7DD3FC" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="Zaman dilimi" Foreground="#CBD5E1" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Border x:Name="bdSlot1" Tag="09:00 – 11:00" MouseLeftButtonDown="BdSlot_Click" Background="#1D4E6D" CornerRadius="7" Padding="13,8" Margin="0,0,6,0"><TextBlock Text="09:00 – 11:00" Style="{StaticResource SlotText}" Foreground="#E0F2FE"/></Border>
                    <Border x:Name="bdSlot2" Tag="11:00 – 13:00" MouseLeftButtonDown="BdSlot_Click" Background="#18263A" CornerRadius="7" Padding="13,8" Margin="0,0,6,0"><TextBlock Text="11:00 – 13:00" Style="{StaticResource SlotText}"/></Border>
                    <Border x:Name="bdSlot3" Tag="13:00 – 15:00" MouseLeftButtonDown="BdSlot_Click" Background="#18263A" CornerRadius="7" Padding="13,8" Margin="0,0,6,0"><TextBlock Text="13:00 – 15:00" Style="{StaticResource SlotText}"/></Border>
                    <Border x:Name="bdSlot4" Tag="15:00 – 17:00" MouseLeftButtonDown="BdSlot_Click" Background="#18263A" CornerRadius="7" Padding="13,8" Margin="0,0,6,0"><TextBlock Text="15:00 – 17:00" Style="{StaticResource SlotText}"/></Border>
                    <Border x:Name="bdSlot5" Tag="17:00 – 19:00" MouseLeftButtonDown="BdSlot_Click" Background="#18263A" CornerRadius="7" Padding="13,8" Margin="0,0,6,0"><TextBlock Text="17:00 – 19:00" Style="{StaticResource SlotText}"/></Border>
                    <Border x:Name="bdSlot6" Tag="19:00 – 22:00" MouseLeftButtonDown="BdSlot_Click" Background="#18263A" CornerRadius="7" Padding="13,8"><TextBlock Text="19:00 – 22:00" Style="{StaticResource SlotText}"/></Border>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0">
                    <Border Width="8" Height="8" CornerRadius="4" Background="#35D399" Margin="0,0,5,0"/>
                    <TextBlock Text="Müsait" Style="{StaticResource QuietText}" Margin="0,0,12,0"/>
                    <Border Width="8" Height="8" CornerRadius="4" Background="#F59E0B" Margin="0,0,5,0"/>
                    <TextBlock Text="Rezerve" Style="{StaticResource QuietText}" Margin="0,0,12,0"/>
                    <Border Width="8" Height="8" CornerRadius="4" Background="#64748B" Margin="0,0,5,0"/>
                    <TextBlock Text="Kullanımda" Style="{StaticResource QuietText}"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="350"/>
            </Grid.ColumnDefinitions>
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,18,0">
                <StackPanel>
                    <Grid Margin="0,0,0,14">
                        <TextBlock Text="Çalışma alanları" Foreground="#F1F5F9" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock x:Name="txtDolulukOran" Text="Doluluk: %0" Style="{StaticResource QuietText}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>

                    <Border Style="{StaticResource SectionCard}">
                        <StackPanel>
                            <Grid Margin="0,0,0,14">
                                <StackPanel Orientation="Horizontal">
                                    <Border Background="#17324A" CornerRadius="6" Padding="7" Margin="0,0,10,0"><materialDesign:PackIcon Kind="VolumeMute" Width="17" Height="17" Foreground="#7DD3FC"/></Border>
                                    <StackPanel><TextBlock Text="Sessiz çalışma" Foreground="#F8FAFC" FontSize="14" FontWeight="SemiBold"/><TextBlock Text="Odaklanmak için düşük ses seviyesi" Style="{StaticResource QuietText}" Margin="0,2,0,0"/></StackPanel>
                                </StackPanel>
                                <TextBlock x:Name="txtSessizSayac" Text="6 / 8 müsait" Style="{StaticResource QuietText}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                            <UniformGrid x:Name="gridSessiz" Columns="4" HorizontalAlignment="Left"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SectionCard}">
                        <StackPanel>
                            <Grid Margin="0,0,0,14">
                                <StackPanel Orientation="Horizontal">
                                    <Border Background="#242050" CornerRadius="6" Padding="7" Margin="0,0,10,0"><materialDesign:PackIcon Kind="Laptop" Width="17" Height="17" Foreground="#C4B5FD"/></Border>
                                    <StackPanel><TextBlock Text="Bireysel bilgisayar" Foreground="#F8FAFC" FontSize="14" FontWeight="SemiBold"/><TextBlock Text="Monitör ve yüksek hızlı bağlantı" Style="{StaticResource QuietText}" Margin="0,2,0,0"/></StackPanel>
                                </StackPanel>
                                <TextBlock x:Name="txtBireyselSayac" Text="5 / 8 müsait" Style="{StaticResource QuietText}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                            <UniformGrid x:Name="gridBireysel" Columns="4" HorizontalAlignment="Left"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SectionCard}">
                        <StackPanel>
                            <Grid Margin="0,0,0,14">
                                <StackPanel Orientation="Horizontal">
                                    <Border Background="#173D39" CornerRadius="6" Padding="7" Margin="0,0,10,0"><materialDesign:PackIcon Kind="AccountGroup" Width="17" Height="17" Foreground="#6EE7B7"/></Border>
                                    <StackPanel><TextBlock Text="Grup odaları" Foreground="#F8FAFC" FontSize="14" FontWeight="SemiBold"/><TextBlock Text="Toplantı ve ortak çalışma alanları" Style="{StaticResource QuietText}" Margin="0,2,0,0"/></StackPanel>
                                </StackPanel>
                                <TextBlock x:Name="txtGrupSayac" Text="3 / 4 müsait" Style="{StaticResource QuietText}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                            <WrapPanel x:Name="pnlGrup"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SectionCard}">
                        <StackPanel>
                            <Grid Margin="0,0,0,14">
                                <StackPanel Orientation="Horizontal">
                                    <Border Background="#3D2C16" CornerRadius="6" Padding="7" Margin="0,0,10,0"><materialDesign:PackIcon Kind="StarFourPoints" Width="17" Height="17" Foreground="#FBBF24"/></Border>
                                    <StackPanel><TextBlock Text="Premium kabinler" Foreground="#F8FAFC" FontSize="14" FontWeight="SemiBold"/><TextBlock Text="Akademik araştırma için özel alanlar" Style="{StaticResource QuietText}" Margin="0,2,0,0"/></StackPanel>
                                </StackPanel>
                                <TextBlock x:Name="txtPremiumSayac" Text="2 / 4 müsait" Style="{StaticResource QuietText}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                            <WrapPanel x:Name="pnlPremium"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Column="1" Background="#111B2E" BorderBrush="#22314A" BorderThickness="1" CornerRadius="14" Padding="20">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Seçili alan" Foreground="#8190A8" FontSize="11" FontWeight="SemiBold"/>
                        <Grid Margin="0,5,0,16">
                            <StackPanel>
                                <TextBlock x:Name="txtMasaKodu" Text="D-103" Foreground="#F8FAFC" FontSize="26" FontWeight="SemiBold"/>
                                <TextBlock x:Name="txtMasaBolum" Text="Sessiz çalışma" Style="{StaticResource QuietText}" Margin="0,3,0,0"/>
                            </StackPanel>
                            <Border x:Name="bdDurumBadge" Background="#123B35" CornerRadius="6" Padding="9,5" HorizontalAlignment="Right" VerticalAlignment="Top">
                                <TextBlock x:Name="txtDurumBadge" Text="MÜSAİT" Foreground="#6EE7B7" FontSize="10" FontWeight="Bold"/>
                            </Border>
                        </Grid>
                        <Border Background="#0C1627" CornerRadius="8" Padding="12" Margin="0,0,0,14">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Text="KAPASİTE" Foreground="#64748B" FontSize="10" FontWeight="SemiBold"/><TextBlock x:Name="txtKapasite" Text="1 kişilik" Foreground="#E2E8F0" FontSize="13" Margin="0,4,0,0"/></StackPanel>
                                <StackPanel Grid.Column="1"><TextBlock Text="KONUM" Foreground="#64748B" FontSize="10" FontWeight="SemiBold"/><TextBlock x:Name="txtKat" Text="Kat 1" Foreground="#E2E8F0" FontSize="13" Margin="0,4,0,0"/></StackPanel>
                            </Grid>
                        </Border>
                        <TextBlock Text="Olanaklar" Foreground="#CBD5E1" FontSize="11" FontWeight="SemiBold"/>
                        <TextBlock x:Name="txtOzellikler" Text="220V priz • 5GHz Wi-Fi" Foreground="#91D5F3" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,14"/>
                        <Border x:Name="bdRezerveEden" Background="#321C1C" CornerRadius="7" Padding="10" Margin="0,0,0,14" Visibility="Collapsed">
                            <StackPanel><TextBlock Text="AKTİF KULLANIM" Foreground="#FCA5A5" FontSize="10" FontWeight="SemiBold"/><TextBlock x:Name="txtRezerveEden" Foreground="#FECACA" FontSize="12" Margin="0,4,0,0"/></StackPanel>
                        </Border>

                        <Border Background="#0C1627" BorderBrush="#22314A" BorderThickness="1" CornerRadius="9" Padding="14" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="Yeni rezervasyon" Foreground="#F8FAFC" FontSize="14" FontWeight="SemiBold"/>
                                <TextBlock Text="Seçili zaman dilimi için alan ayırın." Style="{StaticResource QuietText}" Margin="0,3,0,14"/>
                                <Grid Margin="0,0,0,9"><Grid.ColumnDefinitions><ColumnDefinition Width="92"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Ad soyad" Style="{StaticResource QuietText}" VerticalAlignment="Center"/><TextBox Grid.Column="1" x:Name="txtKullanici" Style="{StaticResource FieldTextBox}"/></Grid>
                                <Grid Margin="0,0,0,9"><Grid.ColumnDefinitions><ColumnDefinition Width="92"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Süre" Style="{StaticResource QuietText}" VerticalAlignment="Center"/><ComboBox Grid.Column="1" x:Name="cbSure" Style="{StaticResource FieldComboBox}" SelectedIndex="1"><ComboBoxItem Content="1 saat"/><ComboBoxItem Content="2 saat"/><ComboBoxItem Content="3 saat"/><ComboBoxItem Content="4 saat"/><ComboBoxItem Content="Tüm gün"/></ComboBox></Grid>
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="92"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Amaç" Style="{StaticResource QuietText}" VerticalAlignment="Top" Margin="0,8,0,0"/><TextBox Grid.Column="1" x:Name="txtAkademikNot" Style="{StaticResource FieldTextBox}" Height="52" TextWrapping="Wrap" VerticalContentAlignment="Top" Padding="10,8"/></Grid>
                                <Button x:Name="btnRezerveEt" Content="Rezervasyonu oluştur" Height="40" Margin="0,14,0,0" Background="#2563EB" Foreground="White" BorderThickness="0" FontWeight="SemiBold" Click="BtnRezerveEt_Click"/>
                                <Button x:Name="btnIptalEt" Content="Rezervasyonu iptal et" Height="34" Margin="0,7,0,0" Background="Transparent" Foreground="#FCA5A5" BorderBrush="#633030" BorderThickness="1" Click="BtnIptalEt_Click"/>
                            </StackPanel>
                        </Border>

                        <Grid Margin="0,3,0,10"><TextBlock Text="Bugünkü rezervasyonlar" Foreground="#CBD5E1" FontSize="13" FontWeight="SemiBold"/><TextBlock Text="Tümü" Foreground="#7DD3FC" FontSize="11" HorizontalAlignment="Right"/></Grid>
                        <ItemsControl x:Name="lstAktifRezervasyonlar">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#0C1627" CornerRadius="7" Padding="10" Margin="0,0,0,6">
                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Kod}" Foreground="#7DD3FC" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1"><TextBlock Text="{Binding Kisi}" Foreground="#E2E8F0" FontSize="11"/><TextBlock Text="{Binding Zaman}" Foreground="#64748B" FontSize="10" Margin="0,2,0,0"/></StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding Sure}" Foreground="#94A3B8" FontSize="10" VerticalAlignment="Center"/>
                                    </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Page>
