<Window x:Class="KutuphaneOtomasyonu.Views.Pages.UyeEkleDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Üye Ekle / Düzenle" Height="620" Width="520"
        WindowStartupLocation="CenterOwner" WindowStyle="None"
        AllowsTransparency="True" Background="Transparent"
        MouseLeftButtonDown="Window_MouseDown">
    <Border Background="#0F172A" CornerRadius="16" BorderBrush="#334155" BorderThickness="1" Padding="24">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Grid Margin="0,0,0,20">
                    <TextBlock x:Name="txtDialogBaslik" Text="👥 Üye Ekle" FontSize="18"
                               FontWeight="Bold" Foreground="White" FontFamily="Segoe UI"
                               VerticalAlignment="Center"/>
                    <Button Style="{StaticResource MaterialDesignIconButton}" Width="32" Height="32"
                            HorizontalAlignment="Right" Foreground="#94A3B8" Click="BtnKapat_Click">
                        <materialDesign:PackIcon Kind="Close" Width="18" Height="18"/>
                    </Button>
                </Grid>

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Text="Ad *" Foreground="#94A3B8" Margin="0,0,0,4"/>
                        <TextBox x:Name="txtAd" Foreground="White"
                                 Style="{StaticResource ModernTextBox}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                        <TextBlock Text="Soyad *" Foreground="#94A3B8" Margin="0,0,0,4"/>
                        <TextBox x:Name="txtSoyad" Foreground="White"
                                 Style="{StaticResource ModernTextBox}"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="T.C. Kimlik No *" Foreground="#94A3B8" Margin="0,0,0,4"/>
                <TextBox x:Name="txtTC" MaxLength="11" Foreground="White"
                         Style="{StaticResource ModernTextBox}" Margin="0,0,0,12"/>

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Text="E-Posta *" Foreground="#94A3B8" Margin="0,0,0,4"/>
                        <TextBox x:Name="txtEmail" Foreground="White"
                                 Style="{StaticResource ModernTextBox}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                        <TextBlock Text="Telefon" Foreground="#94A3B8" Margin="0,0,0,4"/>
                        <TextBox x:Name="txtTelefon" Foreground="White"
                                 Style="{StaticResource ModernTextBox}"/>
                    </StackPanel>
                </Grid>

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Text="Üye Tipi" Foreground="#94A3B8" Margin="0,0,0,4"/>
                        <ComboBox x:Name="cbUyeTipi" Foreground="White"
                                  Style="{StaticResource ModernComboBox}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                        <TextBlock Text="Öğrenci / Sicil No" Foreground="#94A3B8" Margin="0,0,0,4"/>
                        <TextBox x:Name="txtOgrenciNo" Foreground="White"
                                 Style="{StaticResource ModernTextBox}"/>
                    </StackPanel>
                </Grid>

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Text="Bölüm" Foreground="#94A3B8" Margin="0,0,0,4"/>
                        <TextBox x:Name="txtBolum" Foreground="White"
                                 Style="{StaticResource ModernTextBox}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                        <TextBlock Text="Fakülte" Foreground="#94A3B8" Margin="0,0,0,4"/>
                        <TextBox x:Name="txtFakulte" Foreground="White"
                                 Style="{StaticResource ModernTextBox}"/>
                    </StackPanel>
                </Grid>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                    <Button Content="İptal" Width="100" Height="40" Margin="0,0,12,0"
                            Foreground="#94A3B8" Style="{StaticResource MaterialDesignOutlinedButton}"
                            Click="BtnKapat_Click"/>
                    <Button Content="Kaydet" Width="120" Height="40" Foreground="White"
                            FontWeight="SemiBold" materialDesign:ButtonAssist.CornerRadius="10"
                            Click="BtnKaydet_Click">
                        <Button.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#3B82F6" Offset="0"/>
                                <GradientStop Color="#8B5CF6" Offset="1"/>
                            </LinearGradientBrush>
                        </Button.Background>
                    </Button>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Border>
</Window>
