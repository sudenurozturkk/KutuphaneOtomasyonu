<Page x:Class="KutuphaneOtomasyonu.Views.Pages.CuzdanPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      Background="#0B1120">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Başlık -->
        <StackPanel Grid.Row="0" Margin="0,0,0,24">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="💳 Dijital Kütüphane Kartım &amp; Cüzdan" FontSize="22" FontWeight="Bold"
                           Foreground="White" FontFamily="Segoe UI"/>
                <Border Background="#1E293B" CornerRadius="8" Padding="10,4" Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="NFC &amp; Barkod Destekli Akıllı Kart" FontSize="12" Foreground="#A855F7" FontWeight="SemiBold"/>
                </Border>
            </StackPanel>
            <TextBlock Text="Üye kartını görüntüleyin, bankoda alınan nakit ile bakiye yükleyin ve cezaları cüzdandan tahsil edin."
                       FontSize="13" Foreground="#94A3B8" Margin="0,6,0,0"/>
            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                <TextBlock Text="Üye:" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <ComboBox x:Name="cbUye" Width="320" DisplayMemberPath="TamAd" IsEditable="True" IsTextSearchEnabled="True"
                          Style="{StaticResource ModernComboBox}" SelectionChanged="CbUye_SelectionChanged"/>
            </StackPanel>
        </StackPanel>

        <!-- Kart ve Cüzdan Paneli -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="460"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Sol: Akıllı Dijital Kart (Görsel Simülatör) -->
            <StackPanel Grid.Column="0" Margin="0,0,24,0">
                <!-- Dijital Kart Tasarımı -->
                <Border CornerRadius="20" Padding="24" Height="260" Margin="0,0,0,20">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#1E1B4B" Offset="0"/>
                            <GradientStop Color="#312E81" Offset="0.5"/>
                            <GradientStop Color="#4338CA" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.Effect>
                        <DropShadowEffect Color="#4338CA" BlurRadius="24" ShadowDepth="4" Opacity="0.4"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Üst Bar: Logo ve Üniversite -->
                        <Grid Grid.Row="0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🏛️" FontSize="20" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <StackPanel>
                                    <TextBlock Text="ÜNİVERSİTE KÜTÜPHANESİ" FontSize="12" FontWeight="Bold" Foreground="White"/>
                                    <TextBlock Text="AKILLI DİJİTAL ÜYE KARTI" FontSize="9" Foreground="#A5B4FC"/>
                                </StackPanel>
                            </StackPanel>
                            <TextBlock Text="NFC )))" HorizontalAlignment="Right" Foreground="#C7D2FE" FontSize="11" FontWeight="Bold"/>
                        </Grid>

                        <!-- Orta: Çip, Avatar ve İsim -->
                        <Grid Grid.Row="1" Margin="0,16,0,16">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="txtKartUyeAdi" Text="Üye seçin" FontSize="20" FontWeight="Bold" Foreground="White"/>
                                <TextBlock x:Name="txtKartUyeTip" Text="" FontSize="12" Foreground="#C7D2FE" Margin="0,2,0,8"/>
                                <TextBlock x:Name="txtKartOgrenciNo" Text="" FontSize="13" FontFamily="Consolas" Foreground="#FDE047"/>
                            </StackPanel>
                        </Grid>

                        <!-- Alt: Barkod ve Kart ID -->
                        <Grid Grid.Row="2">
                            <TextBlock Text="||| | ||||| || |||| ||||| |||| || |" FontFamily="Consolas" FontSize="18" Foreground="White" VerticalAlignment="Center"/>
                            <TextBlock x:Name="txtKartBakiyeGoster" Text="Bakiye: ₺0,00" HorizontalAlignment="Right" FontSize="16" FontWeight="Bold" Foreground="#34D399" VerticalAlignment="Center"/>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Bakiye Yükleme Butonları -->
                <Border Background="#0F172A" CornerRadius="16" BorderBrush="#1E293B" BorderThickness="1" Padding="20">
                    <StackPanel>
                        <TextBlock Text="💰 Cüzdana Hızlı Bakiye Yükle" FontSize="15" FontWeight="Bold" Foreground="White" Margin="0,0,0,12"/>
                        <UniformGrid Columns="3" Margin="0,0,0,12">
                            <Button x:Name="btnYukle20" Content="+ ₺20" Margin="0,0,4,0" Style="{StaticResource MaterialDesignOutlinedButton}" Click="BtnYukle20_Click"/>
                            <Button x:Name="btnYukle50" Content="+ ₺50" Margin="2,0" Style="{StaticResource MaterialDesignOutlinedButton}" Click="BtnYukle50_Click"/>
                            <Button x:Name="btnYukle100" Content="+ ₺100" Margin="4,0,0,0" Style="{StaticResource MaterialDesignOutlinedButton}" Click="BtnYukle100_Click"/>
                        </UniformGrid>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Sağ: Ceza Borcu ve Geçmiş Ödemeler -->
            <Border Grid.Column="1" Background="#0F172A" CornerRadius="16" BorderBrush="#1E293B" BorderThickness="1" Padding="24">
                <StackPanel>
                    <TextBlock Text="⚠️ Bekleyen Ceza Borcu" FontSize="16" FontWeight="Bold" Foreground="White" Margin="0,0,0,16"/>

                    <Border Background="#1E293B" CornerRadius="14" Padding="20" Margin="0,0,0,20">
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="Toplam Ceza Borcu" FontSize="13" Foreground="#94A3B8"/>
                                <TextBlock x:Name="txtToplamBorc" Text="₺0,00" FontSize="32" FontWeight="Bold" Foreground="#EF4444" Margin="0,4,0,0"/>
                                <TextBlock x:Name="txtBorcDetay" Text="" FontSize="12" Foreground="#FCA5A5" Margin="0,4,0,0" TextWrapping="Wrap" MaxWidth="320"/>
                            </StackPanel>
                            <Button x:Name="btnCezaOde" Content="Cüzdandan Öde" HorizontalAlignment="Right" VerticalAlignment="Center"
                                    Height="44" Padding="20,0" FontWeight="Bold" Foreground="White"
                                    materialDesign:ButtonAssist.CornerRadius="10" Click="BtnCezaOde_Click">
                                <Button.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#EF4444" Offset="0"/>
                                        <GradientStop Color="#DC2626" Offset="1"/>
                                    </LinearGradientBrush>
                                </Button.Background>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Ödeme Geçmişi -->
                    <TextBlock Text="📜 Son Finansal Hareketler &amp; Makbuzlar" FontSize="15" FontWeight="Bold" Foreground="White" Margin="0,0,0,12"/>
                    <DataGrid x:Name="dgFinans" AutoGenerateColumns="False" IsReadOnly="True"
                              CanUserAddRows="False" Background="Transparent" BorderThickness="0"
                              GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#1E293B"
                              RowBackground="Transparent" AlternatingRowBackground="#0B1120"
                              Foreground="White" FontFamily="Segoe UI" RowHeight="44" MaxHeight="260">
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource MaterialDesignDataGridColumnHeader}">
                                <Setter Property="Background" Value="#1E293B"/>
                                <Setter Property="Foreground" Value="#94A3B8"/>
                                <Setter Property="Padding" Value="12,10"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="TARİH" Binding="{Binding Tarih}" Width="140"/>
                            <DataGridTextColumn Header="İŞLEM" Binding="{Binding Islem}" Width="*"/>
                            <DataGridTextColumn Header="TUTAR" Binding="{Binding Tutar}" Width="100"/>
                            <DataGridTextColumn Header="DURUM" Binding="{Binding Durum}" Width="120"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
