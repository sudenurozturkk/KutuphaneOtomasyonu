<Window x:Class="KutuphaneOtomasyonu.Views.Pages.RezervasyonEkleDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Yeni Rezervasyon" Height="390" Width="500"
        WindowStartupLocation="CenterOwner" WindowStyle="None"
        AllowsTransparency="True" Background="Transparent"
        MouseLeftButtonDown="Window_MouseDown">
    <Border Background="#0F172A" CornerRadius="16" BorderBrush="#334155" BorderThickness="1" Padding="24">
        <StackPanel>
            <Grid Margin="0,0,0,20">
                <TextBlock Text="Yeni Rezervasyon" FontSize="18" FontWeight="Bold" Foreground="White"/>
                <Button Style="{StaticResource MaterialDesignIconButton}" Width="32" Height="32"
                        HorizontalAlignment="Right" Foreground="#94A3B8" Click="BtnKapat_Click">
                    <materialDesign:PackIcon Kind="Close" Width="18" Height="18"/>
                </Button>
            </Grid>
            <TextBlock Text="Kitap *" Foreground="#94A3B8" Margin="0,0,0,4"/>
            <ComboBox x:Name="cbKitaplar" DisplayMemberPath="Baslik" SelectedValuePath="Id"
                      Style="{StaticResource ModernComboBox}" Margin="0,0,0,14"/>
            <TextBlock Text="Üye *" Foreground="#94A3B8" Margin="0,0,0,4"/>
            <ComboBox x:Name="cbUyeler" DisplayMemberPath="TamAd" SelectedValuePath="Id"
                      Style="{StaticResource ModernComboBox}" Margin="0,0,0,14"/>
            <TextBlock Text="Not" Foreground="#94A3B8" Margin="0,0,0,4"/>
            <TextBox x:Name="txtNotlar" Style="{StaticResource ModernTextBox}" Height="52"
                     TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top"
                     Margin="0,0,0,20"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="İptal" Width="100" Height="40" Margin="0,0,12,0"
                        Style="{StaticResource MaterialDesignOutlinedButton}" Click="BtnKapat_Click"/>
                <Button Content="Rezervasyon Oluştur" Width="170" Height="40"
                        Background="#2563EB" Foreground="White" FontWeight="SemiBold"
                        Click="BtnKaydet_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
