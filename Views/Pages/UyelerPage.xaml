<Page x:Class="KutuphaneOtomasyonu.Views.Pages.UyelerPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      Background="#0A0E1A">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Üye Yönetimi" FontSize="20" FontWeight="SemiBold" Foreground="White" FontFamily="Segoe UI"/>
                <Border CornerRadius="12" Padding="10,4" Margin="12,0,0,0">
                    <Border.Background><SolidColorBrush Color="#1A2540"/></Border.Background>
                    <TextBlock x:Name="txtUyeSayisi" Text="0 üye" FontSize="13" Foreground="#8B5CF6" FontFamily="Segoe UI"/>
                </Border>
            </StackPanel>
            <Button Content="＋  Üye Ekle" HorizontalAlignment="Right" Height="40" Padding="16,0"
                    materialDesign:ButtonAssist.CornerRadius="10"
                    FontFamily="Segoe UI" FontSize="14" FontWeight="SemiBold"
                    Click="BtnUyeEkle_Click">
                <Button.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#8B5CF6" Offset="0"/>
                        <GradientStop Color="#3B82F6" Offset="1"/>
                    </LinearGradientBrush>
                </Button.Background>
                <Button.Foreground><SolidColorBrush Color="White"/></Button.Foreground>
            </Button>
        </Grid>

        <Grid Grid.Row="1" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal">
                <TextBox x:Name="txtArama" Width="300"
                         materialDesign:HintAssist.Hint="🔍  Ad, soyad, öğrenci no ara..."
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         Foreground="White" FontFamily="Segoe UI" Height="44"
                         TextChanged="TxtArama_TextChanged"/>
                <ComboBox x:Name="cbTip" materialDesign:HintAssist.Hint="Tip"
                          Style="{StaticResource MaterialDesignOutlinedComboBox}"
                          Width="140" Foreground="White" FontFamily="Segoe UI"
                          SelectionChanged="CbFiltre_Changed">
                    <ComboBoxItem Content="Tümü"/>
                    <ComboBoxItem Content="Öğrenci"/>
                    <ComboBoxItem Content="Akademisyen"/>
                    <ComboBoxItem Content="Personel"/>
                </ComboBox>
                <ComboBox x:Name="cbDurum" materialDesign:HintAssist.Hint="Durum"
                          Style="{StaticResource MaterialDesignOutlinedComboBox}"
                          Width="140" Foreground="White" FontFamily="Segoe UI"
                          SelectionChanged="CbFiltre_Changed">
                    <ComboBoxItem Content="Tümü"/>
                    <ComboBoxItem Content="Aktif"/>
                    <ComboBoxItem Content="Pasif"/>
                    <ComboBoxItem Content="Askıda"/>
                </ComboBox>
            </StackPanel>
        </Grid>

        <Border Grid.Row="2" CornerRadius="12" ClipToBounds="True">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#1A2540" Offset="0"/>
                    <GradientStop Color="#1E2D4A" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Border.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="16" ShadowDepth="3" Opacity="0.25"/>
            </Border.Effect>

            <DataGrid x:Name="dgUyeler"
                      AutoGenerateColumns="False" IsReadOnly="True"
                      CanUserAddRows="False" Background="Transparent"
                      BorderThickness="0" GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#0F1729"
                      RowBackground="Transparent" AlternatingRowBackground="#0D1829"
                      Foreground="White" FontFamily="Segoe UI" RowHeight="52"
                      MouseDoubleClick="DgUyeler_MouseDoubleClick">

                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource MaterialDesignDataGridColumnHeader}">
                        <Setter Property="Background" Value="#0F1729"/>
                        <Setter Property="Foreground" Value="#64748B"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="Padding" Value="16,12"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>

                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow" BasedOn="{StaticResource MaterialDesignDataGridRow}">
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#1A3A6C"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#162033"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>

                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="60">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="Foreground" Value="#64748B"/>
                                <Setter Property="Margin" Value="16,0"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="AD SOYAD" Binding="{Binding TamAd}" Width="*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="Margin" Value="8,0"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="ÖĞRENCİ NO" Binding="{Binding OgrenciNo}" Width="140">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="Foreground" Value="#94A3B8"/>
                                <Setter Property="Margin" Value="8,0"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="TİP" Binding="{Binding UyeTipiMetni}" Width="130">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="Foreground" Value="#8B5CF6"/>
                                <Setter Property="Margin" Value="8,0"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="BÖLÜM" Binding="{Binding Bolum}" Width="200">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="Foreground" Value="#64748B"/>
                                <Setter Property="Margin" Value="8,0"/>
                                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="CEZA" Binding="{Binding KalanCeza, StringFormat=₺{0:N2}}" Width="100">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="Foreground" Value="#EF4444"/>
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTemplateColumn Header="DURUM" Width="100">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border CornerRadius="8" Padding="8,4" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#1A3A2A"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Durumu}" Value="1">
                                                    <Setter Property="Background" Value="#2A2A1A"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Durumu}" Value="2">
                                                    <Setter Property="Background" Value="#2A1A1A"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding Durumu}" FontSize="12" FontFamily="Segoe UI">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#10B981"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Durumu}" Value="1">
                                                        <Setter Property="Foreground" Value="#F59E0B"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Durumu}" Value="2">
                                                        <Setter Property="Foreground" Value="#EF4444"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="İŞLEMLER" Width="140">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0">
                                    <Button ToolTip="Detay" Style="{StaticResource MaterialDesignIconButton}"
                                            Width="32" Height="32" Margin="0,0,4,0"
                                            Tag="{Binding Id}" Click="BtnUyeDetay_Click">
                                        <materialDesign:PackIcon Kind="Eye" Width="16" Height="16" Foreground="#3B82F6"/>
                                    </Button>
                                    <Button ToolTip="Düzenle" Style="{StaticResource MaterialDesignIconButton}"
                                            Width="32" Height="32" Margin="0,0,4,0"
                                            Tag="{Binding Id}" Click="BtnUyeDuzenle_Click">
                                        <materialDesign:PackIcon Kind="Pencil" Width="16" Height="16" Foreground="#F59E0B"/>
                                    </Button>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</Page>
