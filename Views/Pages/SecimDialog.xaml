<Window x:Class="KutuphaneOtomasyonu.Views.Pages.SecimDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Seçim" SizeToContent="Height" Width="480"
        WindowStartupLocation="CenterOwner" WindowStyle="None"
        AllowsTransparency="True" Background="Transparent"
        MouseLeftButtonDown="Window_MouseDown">
    <Border Background="#0F172A" CornerRadius="16" BorderBrush="#334155" BorderThickness="1" Padding="24">
        <StackPanel>
            <Grid Margin="0,0,0,8">
                <TextBlock x:Name="txtBaslik" FontSize="18" FontWeight="Bold" Foreground="White"/>
                <Button Style="{StaticResource MaterialDesignIconButton}" Width="32" Height="32"
                        HorizontalAlignment="Right" Foreground="#94A3B8" Click="BtnKapat_Click">
                    <materialDesign:PackIcon Kind="Close" Width="18" Height="18"/>
                </Button>
            </Grid>
            <TextBlock x:Name="txtAciklama" Foreground="#94A3B8" TextWrapping="Wrap" Margin="0,0,0,14"/>
            <ItemsControl x:Name="icAlanlar">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,0,0,14">
                            <TextBlock Text="{Binding Etiket}" Foreground="#94A3B8" Margin="0,0,0,4"/>
                            <ComboBox ItemsSource="{Binding Secenekler}" DisplayMemberPath="{Binding GosterimAlani}"
                                      SelectedItem="{Binding Secilen, Mode=TwoWay}"
                                      IsEditable="True" IsTextSearchEnabled="True"
                                      Style="{StaticResource ModernComboBox}"/>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
                <Button Content="İptal" Width="100" Height="40" Margin="0,0,12,0"
                        Style="{StaticResource MaterialDesignOutlinedButton}" Click="BtnKapat_Click"/>
                <Button x:Name="btnOnayla" Content="Onayla" Width="140" Height="40"
                        Background="#2563EB" Foreground="White" FontWeight="SemiBold"
                        Click="BtnOnayla_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
