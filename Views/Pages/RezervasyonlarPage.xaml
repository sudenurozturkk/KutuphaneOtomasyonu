<Page x:Class="KutuphaneOtomasyonu.Views.Pages.RezervasyonlarPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      Background="#080C18">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Başlık Satırı -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="40" Height="40" CornerRadius="10" Margin="0,0,12,0">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#FB923C" Offset="0"/>
                            <GradientStop Color="#EA580C" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <materialDesign:PackIcon Kind="CalendarClock" Width="20" Height="20" Foreground="White"
                                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Kitap Rezervasyon Kuyruğu" FontSize="18" FontWeight="Bold" Foreground="White" FontFamily="Segoe UI"/>
                    <TextBlock Text="Ödünçte olan kitaplar için üye bekleme sırası ve öncelik yönetimi" FontSize="11.5" Foreground="#94A3B8"/>
                </StackPanel>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Content="🔄 Yenile" Style="{StaticResource MaterialDesignOutlinedButton}"
                        BorderBrush="#334155" Foreground="#94A3B8" Height="36" Padding="12,0" Margin="0,0,8,0"
                        materialDesign:ButtonAssist.CornerRadius="8" Click="BtnYenile_Click"/>
                <Button Content="➕ Yeni Rezervasyon" Height="36" Padding="14,0"
                        materialDesign:ButtonAssist.CornerRadius="8"
                        FontFamily="Segoe UI" FontSize="12.5" FontWeight="SemiBold"
                        Click="BtnYeniRezervasyon_Click">
                    <Button.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#EA580C" Offset="0"/>
                            <GradientStop Color="#F97316" Offset="1"/>
                        </LinearGradientBrush>
                    </Button.Background>
                    <Button.Foreground><SolidColorBrush Color="White"/></Button.Foreground>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Filtre ve Arama Araç Çubuğu -->
        <Grid Grid.Row="1" Margin="0,0,0,14">
            <StackPanel Orientation="Horizontal">
                <TextBox x:Name="txtArama" Width="280" Height="38"
                         materialDesign:HintAssist.Hint="🔍 Kitap veya üye ara..."
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         Foreground="White" FontFamily="Segoe UI" Margin="0,0,10,0"
                         TextChanged="TxtArama_TextChanged"/>
                <ComboBox x:Name="cbFiltreDurum" Width="160" Height="38"
                          materialDesign:HintAssist.Hint="Durum Filtresi"
                          Style="{StaticResource MaterialDesignOutlinedComboBox}"
                          Foreground="White" FontFamily="Segoe UI"
                          SelectionChanged="CbFiltreDurum_SelectionChanged">
                    <ComboBoxItem Content="Tümü" IsSelected="True"/>
                    <ComboBoxItem Content="Bekliyor"/>
                    <ComboBoxItem Content="Onaylandı"/>
                    <ComboBoxItem Content="Tamamlandı"/>
                    <ComboBoxItem Content="İptal"/>
                </ComboBox>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="btnOdunceDonustur" Content="✓ Ödünce Dönüştür" Height="36" Padding="12,0"
                        materialDesign:ButtonAssist.CornerRadius="8" Margin="0,0,8,0"
                        Background="#059669" Foreground="White" FontWeight="SemiBold"
                        Click="BtnOdunceDonustur_Click" IsEnabled="False"/>
                <Button x:Name="btnIptalEt" Content="✕ Sırayı İptal Et" Height="36" Padding="12,0"
                        materialDesign:ButtonAssist.CornerRadius="8"
                        Background="#7F1D1D" Foreground="#FCA5A5" FontWeight="SemiBold"
                        Click="BtnIptalEt_Click" IsEnabled="False"/>
            </StackPanel>
        </Grid>

        <!-- Liste Kartı -->
        <Border Grid.Row="2" CornerRadius="12" ClipToBounds="True" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1">
            <DataGrid x:Name="dgRezervasyonlar"
                      AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                      Background="Transparent" BorderThickness="0"
                      GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#1E293B"
                      RowBackground="Transparent" AlternatingRowBackground="#0A0F1E"
                      Foreground="White" FontFamily="Segoe UI" RowHeight="48"
                      SelectionChanged="DgRezervasyonlar_SelectionChanged">
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource MaterialDesignDataGridColumnHeader}">
                        <Setter Property="Background" Value="#060A14"/>
                        <Setter Property="Foreground" Value="#64748B"/>
                        <Setter Property="Padding" Value="14,10"/>
                        <Setter Property="FontSize" Value="11.5"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>

                <DataGrid.Columns>
                    <DataGridTextColumn Header="NO" Binding="{Binding SiraNumarasi}" Width="55"/>
                    <DataGridTextColumn Header="KİTAP" Binding="{Binding Kitap.Baslik}" Width="*"/>
                    <DataGridTextColumn Header="ÜYE" Binding="{Binding Uye.TamAd}" Width="190"/>
                    <DataGridTextColumn Header="TALEP TARİHİ" Binding="{Binding RezervasyonTarihi, StringFormat=dd.MM.yyyy HH:mm}" Width="145"/>
                    <DataGridTextColumn Header="GEÇERLİLİK" Binding="{Binding GecerlilikTarihi, StringFormat=dd.MM.yyyy}" Width="110"/>
                    <DataGridTemplateColumn Header="DURUM" Width="120">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border CornerRadius="6" Padding="8,3" HorizontalAlignment="Left"
                                        Background="#1E293B">
                                    <TextBlock Text="{Binding Durumu}" FontSize="11" FontWeight="SemiBold" Foreground="#38BDF8"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="NOTLAR" Binding="{Binding Notlar}" Width="160"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</Page>
