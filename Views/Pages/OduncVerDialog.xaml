<Window x:Class="KutuphaneOtomasyonu.Views.Pages.OduncVerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Ödünç Ver" Height="420" Width="480"
        WindowStartupLocation="CenterOwner" WindowStyle="None"
        AllowsTransparency="True" Background="Transparent"
        MouseLeftButtonDown="Window_MouseDown">
    <Border Background="#0F172A" CornerRadius="16" BorderBrush="#334155" BorderThickness="1" Padding="24">
        <StackPanel>
            <Grid Margin="0,0,0,20">
                <TextBlock Text="🔄 Kitap Ödünç Ver" FontSize="18" FontWeight="Bold"
                           Foreground="White" FontFamily="Segoe UI" VerticalAlignment="Center"/>
                <Button Style="{StaticResource MaterialDesignIconButton}" Width="32" Height="32"
                        HorizontalAlignment="Right" Foreground="#94A3B8" Click="BtnKapat_Click">
                    <materialDesign:PackIcon Kind="Close" Width="18" Height="18"/>
                </Button>
            </Grid>

            <TextBlock Text="Kitap Seçin *" Foreground="#94A3B8" Margin="0,0,0,4"/>
            <ComboBox x:Name="cbKitaplar" Foreground="White"
                      Style="{StaticResource ModernComboBox}"
                      DisplayMemberPath="Baslik" SelectedValuePath="Id" Margin="0,0,0,16"/>

            <TextBlock Text="Üye Seçin *" Foreground="#94A3B8" Margin="0,0,0,4"/>
            <ComboBox x:Name="cbUyeler" Foreground="White"
                      Style="{StaticResource ModernComboBox}"
                      DisplayMemberPath="TamAd" SelectedValuePath="Id" Margin="0,0,0,24"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="İptal" Width="100" Height="40" Margin="0,0,12,0"
                        Foreground="#94A3B8" Style="{StaticResource MaterialDesignOutlinedButton}"
                        Click="BtnKapat_Click"/>
                <Button Content="Ödünç Ver" Width="130" Height="40" Foreground="White"
                        FontWeight="SemiBold" materialDesign:ButtonAssist.CornerRadius="10"
                        Click="BtnKaydet_Click">
                    <Button.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#14B8A6" Offset="0"/>
                            <GradientStop Color="#3B82F6" Offset="1"/>
                        </LinearGradientBrush>
                    </Button.Background>
                </Button>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
