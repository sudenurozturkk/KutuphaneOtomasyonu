<Page x:Class="KutuphaneOtomasyonu.Views.Pages.DashboardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      Background="#080C18">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,24,28,24">

            <!-- Başlık Satırı -->
            <Grid Margin="0,0,0,28">
                <StackPanel>
                    <TextBlock x:Name="txtKarsilama" Text="Merhaba 👋" FontSize="26" FontWeight="Bold"
                               Foreground="White" FontFamily="Segoe UI"/>
                    <TextBlock x:Name="txtTarih" Text="" FontSize="13" Foreground="#94A3B8"
                               FontFamily="Segoe UI" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Border Background="#0F1A30" CornerRadius="10" Padding="12,8" Margin="0,0,10,0"
                            BorderBrush="#1E3A5F" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Fill="#10B981" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="Sistem Aktif" FontSize="12" Foreground="#34D399" FontFamily="Segoe UI" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>
                    <Button Style="{StaticResource MaterialDesignRaisedButton}"
                            Click="BtnYenile_Click" materialDesign:ButtonAssist.CornerRadius="10"
                            Padding="14,8" Height="38">
                        <Button.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#1D4ED8" Offset="0"/>
                                <GradientStop Color="#7C3AED" Offset="1"/>
                            </LinearGradientBrush>
                        </Button.Background>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Refresh" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="White"/>
                            <TextBlock Text="Yenile" FontSize="13" FontFamily="Segoe UI" Foreground="White"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- 4 KPI Kartı -->
            <UniformGrid Columns="4" Margin="0,0,0,24">

                <!-- Toplam Kitap -->
                <Border Margin="0,0,10,0" CornerRadius="16" Padding="20" BorderThickness="1" BorderBrush="#1E3A5F">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#0F1A30" Offset="0"/>
                            <GradientStop Color="#132040" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.Effect>
                        <DropShadowEffect Color="#000000" BlurRadius="16" ShadowDepth="2" Opacity="0.2"/>
                    </Border.Effect>
                    <StackPanel>
                        <Grid Margin="0,0,0,14">
                            <Border Width="44" Height="44" CornerRadius="12" HorizontalAlignment="Left">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#1D4ED8" Offset="0"/>
                                        <GradientStop Color="#2563EB" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Border.Effect>
                                    <DropShadowEffect Color="#2563EB" BlurRadius="12" ShadowDepth="0" Opacity="0.5"/>
                                </Border.Effect>
                                <materialDesign:PackIcon Kind="BookMultiple" Width="22" Height="22"
                                                         HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White"/>
                            </Border>
                        </Grid>
                        <TextBlock x:Name="txtToplamKitap" Text="0" FontSize="36" FontWeight="Bold"
                                   Foreground="White" FontFamily="Segoe UI"/>
                        <TextBlock Text="Toplam Kitap" FontSize="13" Foreground="#475569" FontFamily="Segoe UI" Margin="0,2,0,0"/>
                        <TextBlock x:Name="txtKitapAlt" Text="" FontSize="11" Foreground="#3B82F6"
                                   FontFamily="Segoe UI" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Aktif Ödünç -->
                <Border Margin="5,0" CornerRadius="16" Padding="20" BorderThickness="1" BorderBrush="#1E3A5F">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#0F1A30" Offset="0"/>
                            <GradientStop Color="#132040" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.Effect>
                        <DropShadowEffect Color="#000000" BlurRadius="16" ShadowDepth="2" Opacity="0.2"/>
                    </Border.Effect>
                    <StackPanel>
                        <Grid Margin="0,0,0,14">
                            <Border Width="44" Height="44" CornerRadius="12" HorizontalAlignment="Left">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#047857" Offset="0"/>
                                        <GradientStop Color="#059669" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Border.Effect>
                                    <DropShadowEffect Color="#059669" BlurRadius="12" ShadowDepth="0" Opacity="0.5"/>
                                </Border.Effect>
                                <materialDesign:PackIcon Kind="SwapHorizontal" Width="22" Height="22"
                                                         HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White"/>
                            </Border>
                        </Grid>
                        <TextBlock x:Name="txtAktifOdunc" Text="0" FontSize="36" FontWeight="Bold"
                                   Foreground="White" FontFamily="Segoe UI"/>
                        <TextBlock Text="Aktif Ödünç" FontSize="13" Foreground="#475569" FontFamily="Segoe UI" Margin="0,2,0,0"/>
                        <TextBlock x:Name="txtOduncAlt" Text="" FontSize="11" Foreground="#10B981"
                                   FontFamily="Segoe UI" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Gecikmiş -->
                <Border Margin="5,0" CornerRadius="16" Padding="20" BorderThickness="1" BorderBrush="#1E3A5F">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#0F1A30" Offset="0"/>
                            <GradientStop Color="#132040" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.Effect>
                        <DropShadowEffect Color="#000000" BlurRadius="16" ShadowDepth="2" Opacity="0.2"/>
                    </Border.Effect>
                    <StackPanel>
                        <Grid Margin="0,0,0,14">
                            <Border Width="44" Height="44" CornerRadius="12" HorizontalAlignment="Left">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#B91C1C" Offset="0"/>
                                        <GradientStop Color="#EF4444" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Border.Effect>
                                    <DropShadowEffect Color="#EF4444" BlurRadius="12" ShadowDepth="0" Opacity="0.5"/>
                                </Border.Effect>
                                <materialDesign:PackIcon Kind="AlertCircle" Width="22" Height="22"
                                                         HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White"/>
                            </Border>
                        </Grid>
                        <TextBlock x:Name="txtGecikmis" Text="0" FontSize="36" FontWeight="Bold"
                                   Foreground="#EF4444" FontFamily="Segoe UI"/>
                        <TextBlock Text="Gecikmiş İade" FontSize="13" Foreground="#475569" FontFamily="Segoe UI" Margin="0,2,0,0"/>
                        <TextBlock x:Name="txtGecikmisAlt" Text="" FontSize="11" Foreground="#EF4444"
                                   FontFamily="Segoe UI" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Toplam Üye -->
                <Border Margin="10,0,0,0" CornerRadius="16" Padding="20" BorderThickness="1" BorderBrush="#1E3A5F">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#0F1A30" Offset="0"/>
                            <GradientStop Color="#132040" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.Effect>
                        <DropShadowEffect Color="#000000" BlurRadius="16" ShadowDepth="2" Opacity="0.2"/>
                    </Border.Effect>
                    <StackPanel>
                        <Grid Margin="0,0,0,14">
                            <Border Width="44" Height="44" CornerRadius="12" HorizontalAlignment="Left">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#6D28D9" Offset="0"/>
                                        <GradientStop Color="#8B5CF6" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Border.Effect>
                                    <DropShadowEffect Color="#8B5CF6" BlurRadius="12" ShadowDepth="0" Opacity="0.5"/>
                                </Border.Effect>
                                <materialDesign:PackIcon Kind="AccountGroup" Width="22" Height="22"
                                                         HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White"/>
                            </Border>
                        </Grid>
                        <TextBlock x:Name="txtToplamUye" Text="0" FontSize="36" FontWeight="Bold"
                                   Foreground="White" FontFamily="Segoe UI"/>
                        <TextBlock Text="Kayıtlı Üye" FontSize="13" Foreground="#475569" FontFamily="Segoe UI" Margin="0,2,0,0"/>
                        <TextBlock x:Name="txtUyeAlt" Text="" FontSize="11" Foreground="#8B5CF6"
                                   FontFamily="Segoe UI" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Orta Alan: Gecikmiş + Hızlı İşlemler -->
            <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="340"/>
                </Grid.ColumnDefinitions>

                <!-- Gecikmiş İadeler Tablosu -->
                <Border Grid.Column="0" Margin="0,0,14,0" CornerRadius="16" Padding="22"
                        BorderThickness="1" BorderBrush="#1E3A5F">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#0F1A30" Offset="0"/>
                            <GradientStop Color="#132040" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <Border Width="36" Height="36" CornerRadius="10" Margin="0,0,12,0">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#B91C1C" Offset="0"/>
                                        <GradientStop Color="#EF4444" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <materialDesign:PackIcon Kind="AlertCircle" Width="18" Height="18"
                                                         HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White"/>
                            </Border>
                            <TextBlock Text="Gecikmiş İadeler" FontSize="15" FontWeight="SemiBold"
                                       Foreground="White" FontFamily="Segoe UI" VerticalAlignment="Center"/>
                        </StackPanel>

                        <DataGrid x:Name="dgGecikmisOduncler"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  HeadersVisibility="Column"
                                  CanUserAddRows="False"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="#0F1A30"
                                  RowBackground="Transparent"
                                  AlternatingRowBackground="#060A14"
                                  Foreground="White"
                                  FontFamily="Segoe UI"
                                  MaxHeight="280"
                                  RowHeight="48">
                            <DataGrid.ColumnHeaderStyle>
                                <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource MaterialDesignDataGridColumnHeader}">
                                    <Setter Property="Background" Value="#060A14"/>
                                    <Setter Property="Foreground" Value="#334155"/>
                                    <Setter Property="Padding" Value="12,10"/>
                                    <Setter Property="FontSize" Value="11"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                </Style>
                            </DataGrid.ColumnHeaderStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="KİTAP" Binding="{Binding Kitap.Baslik}" Width="*">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="White"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="Margin" Value="12,0,0,0"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="ÜYE" Binding="{Binding Uye.TamAd}" Width="160">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#94A3B8"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="PLANLANAN" Binding="{Binding PlanlananIadeTarihi, StringFormat=dd.MM.yyyy}" Width="110">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#F59E0B"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="DURUM" Binding="{Binding DurumMetni}" Width="160">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#EF4444"/>
                                            <Setter Property="FontWeight" Value="Bold"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <TextBlock x:Name="txtGecikmisBos" Text="✅ Gecikmiş iade yok!" FontSize="14"
                                   Foreground="#10B981" FontFamily="Segoe UI" HorizontalAlignment="Center"
                                   Margin="0,24" Visibility="Collapsed"/>
                    </StackPanel>
                </Border>

                <!-- Hızlı İşlemler Paneli -->
                <Border Grid.Column="1" CornerRadius="16" Padding="22"
                        BorderThickness="1" BorderBrush="#1E3A5F">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#0F1A30" Offset="0"/>
                            <GradientStop Color="#132040" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <StackPanel>
                        <TextBlock Text="⚡ Hızlı İşlemler" FontSize="15" FontWeight="SemiBold"
                                   Foreground="White" FontFamily="Segoe UI" Margin="0,0,0,16"/>

                        <Button Height="46" Margin="0,0,0,10"
                                materialDesign:ButtonAssist.CornerRadius="12"
                                FontFamily="Segoe UI" FontWeight="SemiBold" FontSize="13"
                                Click="BtnHizliKitapEkle_Click">
                            <Button.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#1D4ED8" Offset="0"/>
                                    <GradientStop Color="#2563EB" Offset="1"/>
                                </LinearGradientBrush>
                            </Button.Background>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="BookPlus" Width="18" Height="18" Foreground="White" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="Yeni Kitap Ekle" Foreground="White" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Height="46" Margin="0,0,0,10"
                                materialDesign:ButtonAssist.CornerRadius="12"
                                FontFamily="Segoe UI" FontWeight="SemiBold" FontSize="13"
                                Click="BtnHizliOduncVer_Click">
                            <Button.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#047857" Offset="0"/>
                                    <GradientStop Color="#059669" Offset="1"/>
                                </LinearGradientBrush>
                            </Button.Background>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="BookArrowRight" Width="18" Height="18" Foreground="White" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="Ödünç Ver" Foreground="White" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Height="46" Margin="0,0,0,10"
                                materialDesign:ButtonAssist.CornerRadius="12"
                                FontFamily="Segoe UI" FontWeight="SemiBold" FontSize="13"
                                Click="BtnHizliIadeAl_Click">
                            <Button.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#6D28D9" Offset="0"/>
                                    <GradientStop Color="#7C3AED" Offset="1"/>
                                </LinearGradientBrush>
                            </Button.Background>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="BookCheck" Width="18" Height="18" Foreground="White" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="İade Al" Foreground="White" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Height="46" Margin="0,0,0,0"
                                materialDesign:ButtonAssist.CornerRadius="12"
                                FontFamily="Segoe UI" FontWeight="SemiBold" FontSize="13"
                                Click="BtnHizliUyeEkle_Click">
                            <Button.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#B45309" Offset="0"/>
                                    <GradientStop Color="#D97706" Offset="1"/>
                                </LinearGradientBrush>
                            </Button.Background>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="AccountPlus" Width="18" Height="18" Foreground="White" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="Yeni Üye Ekle" Foreground="White" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Sistem Durumu -->
                        <Border Margin="0,18,0,0" Padding="14,12" CornerRadius="12" Background="#060A14">
                            <StackPanel>
                                <TextBlock Text="SİSTEM DURUMU" FontSize="10" FontWeight="Bold" Foreground="#334155"
                                           FontFamily="Segoe UI" Margin="0,0,0,10"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <Ellipse Width="7" Height="7" Fill="#10B981" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="Veritabanı: Bağlı" FontSize="12" Foreground="#475569" FontFamily="Segoe UI"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <Ellipse Width="7" Height="7" Fill="#10B981" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="SQLite: Aktif" FontSize="12" Foreground="#475569" FontFamily="Segoe UI"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="7" Height="7" Fill="#10B981" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock x:Name="txtVersuyon" Text="v3.0 Enterprise" FontSize="12" Foreground="#475569" FontFamily="Segoe UI"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Alt Satır: Son İşlemler + Modül Linkleri -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Salon/Masa Durumu Mini Kartı -->
                <Border Grid.Column="0" Margin="0,0,10,0" CornerRadius="16" Padding="20"
                        BorderThickness="1" BorderBrush="#1E3A5F">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#0F1A30" Offset="0"/>
                            <GradientStop Color="#132040" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                            <materialDesign:PackIcon Kind="DeskLamp" Width="18" Height="18" Foreground="#06B6D4"
                                                     VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="Salon Durumu" FontSize="14" FontWeight="SemiBold"
                                       Foreground="White" FontFamily="Segoe UI" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="🪑 Müsait Masalar" FontSize="12" Foreground="#475569" Margin="0,0,0,6"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="16" FontSize="28" FontWeight="Bold" Foreground="#06B6D4" FontFamily="Segoe UI"/>
                            <TextBlock Text="/24" FontSize="16" Foreground="#334155" VerticalAlignment="Bottom" Margin="4,0,0,4"/>
                        </StackPanel>
                        <ProgressBar Value="67" Maximum="100" Height="6"
                                     Foreground="#06B6D4" Background="#1E293B" BorderThickness="0" Margin="0,0,0,8"/>
                        <TextBlock Text="Bugün 47 masa rezervasyonu yapıldı" FontSize="11" Foreground="#334155" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- E-Kitap Durumu -->
                <Border Grid.Column="1" Margin="5,0" CornerRadius="16" Padding="20"
                        BorderThickness="1" BorderBrush="#1E3A5F">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#0F1A30" Offset="0"/>
                            <GradientStop Color="#132040" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                            <materialDesign:PackIcon Kind="BookOpenBlankVariant" Width="18" Height="18" Foreground="#A78BFA"
                                                     VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="E-Kitap Erişimi" FontSize="14" FontWeight="SemiBold"
                                       Foreground="White" FontFamily="Segoe UI" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="📖 Dijital Kitaplar" FontSize="12" Foreground="#475569" Margin="0,0,0,6"/>
                        <TextBlock Text="4" FontSize="28" FontWeight="Bold" Foreground="#A78BFA" FontFamily="Segoe UI" Margin="0,0,0,12"/>
                        <TextBlock Text="Clean Code, GoF, Algoritmalar, YZ kitapları dijital olarak okunabilir"
                                   FontSize="11" Foreground="#334155" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- Ceza/Tahsilat Özeti -->
                <Border Grid.Column="2" Margin="10,0,0,0" CornerRadius="16" Padding="20"
                        BorderThickness="1" BorderBrush="#1E3A5F">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#0F1A30" Offset="0"/>
                            <GradientStop Color="#132040" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                            <materialDesign:PackIcon Kind="CurrencyTry" Width="18" Height="18" Foreground="#F59E0B"
                                                     VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="Finansal Özet" FontSize="14" FontWeight="SemiBold"
                                       Foreground="White" FontFamily="Segoe UI" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="💰 Bekleyen Ceza" FontSize="12" Foreground="#475569" Margin="0,0,0,6"/>
                        <TextBlock x:Name="txtBekilenCeza" Text="₺0,00" FontSize="28" FontWeight="Bold"
                                   Foreground="#F59E0B" FontFamily="Segoe UI" Margin="0,0,0,12"/>
                        <TextBlock x:Name="txtCezaAlt" Text="Tüm cezalar ödenmiş ✅"
                                   FontSize="11" Foreground="#334155" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </Grid>

        </StackPanel>
    </ScrollViewer>
</Page>
