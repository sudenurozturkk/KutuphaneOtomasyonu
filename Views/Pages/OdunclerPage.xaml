<Page x:Class="KutuphaneOtomasyonu.Views.Pages.OdunclerPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      Background="#0A0E1A">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Tab seçimi -->
        <TabControl x:Name="tabOdunc" Grid.Row="0" Margin="0,0,0,16"
                    Style="{StaticResource MaterialDesignTabControl}"
                    Background="Transparent" BorderThickness="0">
            <TabItem Header="Aktif Ödünçler" Style="{StaticResource MaterialDesignTabItem}"
                     Foreground="White" FontFamily="Segoe UI"/>
            <TabItem Header="Gecikmiş" Style="{StaticResource MaterialDesignTabItem}"
                     Foreground="#EF4444" FontFamily="Segoe UI"/>
            <TabItem Header="Tüm Geçmiş" Style="{StaticResource MaterialDesignTabItem}"
                     Foreground="White" FontFamily="Segoe UI"/>
        </TabControl>

        <!-- Araç Çubuğu -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal">
                <TextBox x:Name="txtArama" Width="300"
                         materialDesign:HintAssist.Hint="🔍  Üye adı, kitap veya ID ara..."
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         Foreground="White" FontFamily="Segoe UI" Height="44"
                         Margin="0,0,12,0" TextChanged="TxtArama_TextChanged"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="🔄  Ödünç Ver" Height="44" Padding="16,0"
                        materialDesign:ButtonAssist.CornerRadius="10"
                        FontFamily="Segoe UI" FontSize="14" FontWeight="SemiBold"
                        Click="BtnOduncVer_Click">
                    <Button.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#14B8A6" Offset="0"/>
                            <GradientStop Color="#3B82F6" Offset="1"/>
                        </LinearGradientBrush>
                    </Button.Background>
                    <Button.Foreground>
                        <SolidColorBrush Color="White"/>
                    </Button.Foreground>
                </Button>
                <Button Content="↩️  İade Al" Height="44" Padding="16,0"
                        materialDesign:ButtonAssist.CornerRadius="10"
                        FontFamily="Segoe UI" FontSize="14" FontWeight="SemiBold"
                        Click="BtnIadeAl_Click">
                    <Button.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#8B5CF6" Offset="0"/>
                            <GradientStop Color="#EC4899" Offset="1"/>
                        </LinearGradientBrush>
                    </Button.Background>
                    <Button.Foreground>
                        <SolidColorBrush Color="White"/>
                    </Button.Foreground>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Liste -->
        <Border Grid.Row="2" CornerRadius="12" ClipToBounds="True">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#1A2540" Offset="0"/>
                    <GradientStop Color="#1E2D4A" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Border.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="16" ShadowDepth="3" Opacity="0.25"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <DataGrid x:Name="dgOduncler" Grid.Row="0"
                          AutoGenerateColumns="False" IsReadOnly="True"
                          CanUserAddRows="False" Background="Transparent"
                          BorderThickness="0" GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#0F1729"
                          RowBackground="Transparent" AlternatingRowBackground="#0D1829"
                          Foreground="White" FontFamily="Segoe UI" RowHeight="56">

                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource MaterialDesignDataGridColumnHeader}">
                            <Setter Property="Background" Value="#0F1729"/>
                            <Setter Property="Foreground" Value="#64748B"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="Padding" Value="16,12"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>

                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow" BasedOn="{StaticResource MaterialDesignDataGridRow}">
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#1A3A6C"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#162033"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="60">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Foreground" Value="#64748B"/>
                                    <Setter Property="Margin" Value="16,0"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="KİTAP" Binding="{Binding Kitap.Baslik}" Width="*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="Margin" Value="8,0"/>
                                    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="ÜYE" Binding="{Binding Uye.TamAd}" Width="160">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Foreground" Value="#94A3B8"/>
                                    <Setter Property="Margin" Value="8,0"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="ÖDÜNÇ TARİHİ" Binding="{Binding OduncTarihi, StringFormat=dd.MM.yyyy}" Width="130">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Foreground" Value="#94A3B8"/>
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="İADE TARİHİ" Binding="{Binding PlanlananIadeTarihi, StringFormat=dd.MM.yyyy}" Width="120">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Foreground" Value="#94A3B8"/>
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="DURUM" Binding="{Binding DurumMetni}" Width="180">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Margin" Value="8,0"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="CEZA" Binding="{Binding CezaTutari, StringFormat=₺{0:N2}}" Width="100">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Foreground" Value="#EF4444"/>
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTemplateColumn Header="İŞLEMLER" Width="160">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0">
                                        <Button ToolTip="İade Al" Style="{StaticResource MaterialDesignIconButton}"
                                                Width="32" Height="32" Margin="0,0,4,0"
                                                Tag="{Binding Id}" Click="BtnIade_Click">
                                            <materialDesign:PackIcon Kind="KeyboardReturn" Width="16" Height="16" Foreground="#14B8A6"/>
                                        </Button>
                                        <Button ToolTip="Uzat" Style="{StaticResource MaterialDesignIconButton}"
                                                Width="32" Height="32" Margin="0,0,4,0"
                                                Tag="{Binding Id}" Click="BtnUzat_Click">
                                            <materialDesign:PackIcon Kind="CalendarPlus" Width="16" Height="16" Foreground="#F59E0B"/>
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <Border Grid.Row="1" Padding="16,10" Background="#0F1729">
                    <TextBlock x:Name="txtDurumBilgi" Text="Seçim yapınız"
                               FontSize="12" Foreground="#475569" FontFamily="Segoe UI"/>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Page>
