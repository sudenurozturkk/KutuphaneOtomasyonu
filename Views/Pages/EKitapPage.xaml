<Page x:Class="KutuphaneOtomasyonu.Views.Pages.EKitapPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      Background="#080C18">

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Başlık ve Kontroller -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <StackPanel VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="E-Kitap Okuyucu" FontSize="24" FontWeight="Bold" Foreground="White" FontFamily="Segoe UI"/>
                    <Border Background="#1E293B" CornerRadius="8" Padding="10,4" Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="txtKitapBaslikEtiket" Text="Sayfa 1 / 4"
                                   FontSize="12" Foreground="#38BDF8" FontWeight="SemiBold"/>
                    </Border>
                </StackPanel>
                <TextBlock Text="Kütüphanedeki dijitalleştirilmiş kaynakları ve akademik özetleri doğrudan okuyun."
                           FontSize="13" Foreground="#475569" Margin="0,4,0,0" FontFamily="Segoe UI"/>
            </StackPanel>

            <!-- Okuyucu Araç Çubuğu -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <ComboBox x:Name="cbKitapSecimi" Width="240" Height="40" Margin="0,0,10,0"
                          Style="{StaticResource MaterialDesignOutlinedComboBox}" Foreground="White"
                          SelectionChanged="CbKitapSecimi_SelectionChanged">
                    <ComboBoxItem Content="Temiz Kod (Clean Code)" IsSelected="True"/>
                    <ComboBoxItem Content="Tasarım Desenleri (GoF)"/>
                    <ComboBoxItem Content="Algoritmalar &amp; Veri Yapıları"/>
                    <ComboBoxItem Content="Yapay Zeka: Modern Yaklaşım"/>
                </ComboBox>

                <Button x:Name="btnFontKucult" Content="A-" Width="42" Height="40" Margin="0,0,4,0"
                        Style="{StaticResource MaterialDesignOutlinedButton}"
                        Foreground="#94A3B8" BorderBrush="#1E293B"
                        Click="BtnFontKucult_Click"/>
                <Button x:Name="btnFontBuyut" Content="A+" Width="42" Height="40" Margin="0,0,10,0"
                        Style="{StaticResource MaterialDesignOutlinedButton}"
                        Foreground="#94A3B8" BorderBrush="#1E293B"
                        Click="BtnFontBuyut_Click"/>

                <Button x:Name="btnTemaToggle" Content="☀️ Açık Mod" Height="40" Padding="14,0"
                        Style="{StaticResource MaterialDesignOutlinedButton}"
                        Foreground="#F59E0B" BorderBrush="#F59E0B"
                        Click="BtnTemaToggle_Click"/>
            </StackPanel>
        </Grid>

        <!-- Okuma İlerleme Çubuğu -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <ProgressBar x:Name="pbOkuma" Grid.Column="0" Height="6" Value="25" Maximum="100"
                         Background="#1E293B" Foreground="#38BDF8" BorderThickness="0" VerticalAlignment="Center"
                         materialDesign:TransitionAssist.DisableTransitions="False">
                <ProgressBar.Style>
                    <Style TargetType="ProgressBar" BasedOn="{StaticResource MaterialDesignLinearProgressBar}">
                        <Setter Property="Foreground">
                            <Setter.Value>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#38BDF8" Offset="0"/>
                                    <GradientStop Color="#8B5CF6" Offset="1"/>
                                </LinearGradientBrush>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ProgressBar.Style>
            </ProgressBar>
            <TextBlock x:Name="txtOkumaPct" Grid.Column="1" Text="25%" FontSize="11" Foreground="#38BDF8"
                       FontWeight="Bold" Margin="10,0,0,0" VerticalAlignment="Center"/>
        </Grid>

        <!-- Ana Okuyucu Alanı -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Sol: İçindekiler Paneli -->
            <Border Grid.Column="0" Background="#0F172A" CornerRadius="16"
                    BorderBrush="#1E293B" BorderThickness="1" Padding="20" Margin="0,0,20,0">
                <StackPanel>
                    <TextBlock Text="📖 Kitap Bilgisi" FontSize="13" FontWeight="Bold" Foreground="White" Margin="0,0,0,16"/>

                    <Border Background="#1E293B" CornerRadius="10" Padding="14" Margin="0,0,0,16">
                        <StackPanel>
                            <Border Width="40" Height="56" CornerRadius="4" Margin="0,0,0,10" HorizontalAlignment="Left">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#1E3A5F" Offset="0"/>
                                        <GradientStop Color="#1E2D5F" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <TextBlock Text="📚" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock x:Name="txtKitapAdi" Text="Temiz Kod" FontSize="13" FontWeight="Bold"
                                       Foreground="White" TextWrapping="Wrap"/>
                            <TextBlock x:Name="txtKitapYazar" Text="Robert C. Martin" FontSize="11"
                                       Foreground="#38BDF8" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="📑 Bölümler" FontSize="12" FontWeight="Bold" Foreground="#475569" Margin="0,0,0,10"/>

                    <StackPanel x:Name="pnlIcindekiler">
                        <!-- Dinamik olarak CS'den doldurulacak -->
                    </StackPanel>

                    <!-- Okuma İstatistikleri -->
                    <Border Background="#1E293B" CornerRadius="10" Padding="12" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Text="📊 Oturum İstatistikleri" FontSize="11" FontWeight="Bold"
                                       Foreground="#475569" Margin="0,0,0,8"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <materialDesign:PackIcon Kind="EyeOutline" Width="14" Height="14" Foreground="#38BDF8" Margin="0,0,6,0"/>
                                <TextBlock Text="Okunan sayfa:" FontSize="11" Foreground="#64748B"/>
                                <TextBlock x:Name="txtOkunanSayfa" Text="1" FontSize="11" Foreground="#38BDF8"
                                           FontWeight="Bold" Margin="4,0,0,0"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Timer" Width="14" Height="14" Foreground="#10B981" Margin="0,0,6,0"/>
                                <TextBlock Text="Tahmini süre:" FontSize="11" Foreground="#64748B"/>
                                <TextBlock x:Name="txtTahminiSure" Text="~5 dk" FontSize="11" Foreground="#10B981"
                                           FontWeight="Bold" Margin="4,0,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Sağ: Okuma Kağıdı -->
            <Border Grid.Column="1" x:Name="bdKitapKagidi" CornerRadius="16"
                    BorderBrush="#1E293B" BorderThickness="1" Padding="48,40">
                <Border.Background>
                    <SolidColorBrush Color="#0F172A"/>
                </Border.Background>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Bölüm Başlığı -->
                    <StackPanel Grid.Row="0" Margin="0,0,0,28">
                        <Border Width="4" Height="32" Background="#38BDF8" HorizontalAlignment="Left" CornerRadius="2" Margin="0,0,0,12"/>
                        <TextBlock x:Name="txtBolumBaslik"
                                   Text="Bölüm 1: Anlamlı İsimlendirme"
                                   FontSize="20" FontWeight="Bold" Foreground="#38BDF8"
                                   FontFamily="Segoe UI" TextWrapping="Wrap"/>
                    </StackPanel>

                    <!-- Metin İçeriği -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <TextBlock x:Name="txtKitapIcerik"
                                   FontSize="15" LineHeight="28"
                                   Foreground="#E2E8F0" TextWrapping="Wrap"
                                   FontFamily="Georgia, Cambria, Segoe UI"
                                   Text="Yükleniyor..."/>
                    </ScrollViewer>

                    <!-- Alt Sayfa Gezinme -->
                    <Grid Grid.Row="2" Margin="0,24,0,0">
                        <Border Height="1" Background="#1E293B" VerticalAlignment="Top"/>
                        <Button x:Name="btnOncekiSayfa" Height="42" Width="140" Padding="0"
                                HorizontalAlignment="Left" Margin="0,12,0,0"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                Foreground="#38BDF8" BorderBrush="#38BDF8"
                                Click="BtnOncekiSayfa_Click">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ArrowLeft" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="Önceki Bölüm" VerticalAlignment="Center" FontSize="12"/>
                            </StackPanel>
                        </Button>

                        <TextBlock x:Name="txtSayfaNo" Text="Sayfa 1 / 4"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="#475569" FontSize="12" FontWeight="SemiBold"
                                   Margin="0,12,0,0"/>

                        <Button x:Name="btnSonrakiSayfa" Height="42" Width="140" Padding="0"
                                HorizontalAlignment="Right" Margin="0,12,0,0"
                                Click="BtnSonrakiSayfa_Click">
                            <Button.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#0284C7" Offset="0"/>
                                    <GradientStop Color="#38BDF8" Offset="1"/>
                                </LinearGradientBrush>
                            </Button.Background>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Sonraki Bölüm" VerticalAlignment="Center" FontSize="12" Foreground="White"/>
                                <materialDesign:PackIcon Kind="ArrowRight" Width="16" Height="16" VerticalAlignment="Center"
                                                         Margin="6,0,0,0" Foreground="White"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
