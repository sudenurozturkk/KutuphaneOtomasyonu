<Window x:Class="KutuphaneOtomasyonu.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Kütüphane Yönetim Sistemi - Giriş"
        Height="680" Width="1100"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Border CornerRadius="20" ClipToBounds="True">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="430"/>
            </Grid.ColumnDefinitions>

            <!-- Sol Panel - Hero Tasarım -->
            <Border Grid.Column="0">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#060A18" Offset="0"/>
                        <GradientStop Color="#0D1732" Offset="0.4"/>
                        <GradientStop Color="#0A0E20" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>

                <Grid>
                    <!-- Dekoratif Arka Plan Parıltıları -->
                    <Ellipse Width="500" Height="500" HorizontalAlignment="Left" VerticalAlignment="Top"
                             Margin="-200,-200,0,0" Opacity="0.12">
                        <Ellipse.Fill>
                            <RadialGradientBrush>
                                <GradientStop Color="#2563EB" Offset="0"/>
                                <GradientStop Color="Transparent" Offset="1"/>
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>

                    <Ellipse Width="400" Height="400" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                             Margin="0,0,-150,-150" Opacity="0.08">
                        <Ellipse.Fill>
                            <RadialGradientBrush>
                                <GradientStop Color="#7C3AED" Offset="0"/>
                                <GradientStop Color="Transparent" Offset="1"/>
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>

                    <!-- Sol İçerik -->
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="50">

                        <!-- Logo ve başlık -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Border Width="64" Height="64" CornerRadius="18" Margin="0,0,16,0">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#2563EB" Offset="0"/>
                                        <GradientStop Color="#7C3AED" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Border.Effect>
                                    <DropShadowEffect Color="#2563EB" BlurRadius="24" ShadowDepth="0" Opacity="0.8"/>
                                </Border.Effect>
                                <TextBlock Text="📚" FontSize="30" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Kütüphane" FontSize="28" FontWeight="Bold" Foreground="White" FontFamily="Segoe UI"/>
                                <TextBlock Text="Yönetim Sistemi" FontSize="16" Foreground="#38BDF8" FontFamily="Segoe UI" FontWeight="SemiBold"/>
                            </StackPanel>
                        </StackPanel>

                        <TextBlock Text="Enterprise Suite • Yazılım Tasarım Mimarisi" FontSize="12" Foreground="#94A3B8"
                                   FontFamily="Segoe UI" Margin="0,0,0,36"/>

                        <!-- Özellik Listesi Grid -->
                        <StackPanel>

                            <!-- Satır 1 -->
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,12,0">
                                    <Border Width="38" Height="38" CornerRadius="10" Margin="0,0,12,0" Background="#1E3A8A">
                                        <materialDesign:PackIcon Kind="BookMultiple" Width="20" Height="20"
                                                                 HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#60A5FA"/>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Kitap Kataloğu" FontSize="13" FontWeight="SemiBold" Foreground="White" FontFamily="Segoe UI"/>
                                        <TextBlock Text="ISBN, barkod, akıllı arama" FontSize="11" Foreground="#94A3B8" FontFamily="Segoe UI"/>
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Border Width="38" Height="38" CornerRadius="10" Margin="0,0,12,0" Background="#064E3B">
                                        <materialDesign:PackIcon Kind="SwapHorizontal" Width="20" Height="20"
                                                                 HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#34D399"/>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Ödünç &amp; İade" FontSize="13" FontWeight="SemiBold" Foreground="White" FontFamily="Segoe UI"/>
                                        <TextBlock Text="Gecikme &amp; ceza takibi" FontSize="11" Foreground="#94A3B8" FontFamily="Segoe UI"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>

                            <!-- Satır 2 -->
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,12,0">
                                    <Border Width="38" Height="38" CornerRadius="10" Margin="0,0,12,0" Background="#581C87">
                                        <materialDesign:PackIcon Kind="DeskLamp" Width="20" Height="20"
                                                                 HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#C084FC"/>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="2D Salon Haritası" FontSize="13" FontWeight="SemiBold" Foreground="White" FontFamily="Segoe UI"/>
                                        <TextBlock Text="İnteraktif masa seçimi" FontSize="11" Foreground="#94A3B8" FontFamily="Segoe UI"/>
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Border Width="38" Height="38" CornerRadius="10" Margin="0,0,12,0" Background="#831843">
                                        <materialDesign:PackIcon Kind="Barcode" Width="20" Height="20"
                                                                 HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#F472B6"/>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Barkod Banko" FontSize="13" FontWeight="SemiBold" Foreground="White" FontFamily="Segoe UI"/>
                                        <TextBlock Text="Hızlı işlem terminali" FontSize="11" Foreground="#94A3B8" FontFamily="Segoe UI"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>

                            <!-- Satır 3 -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,12,0">
                                    <Border Width="38" Height="38" CornerRadius="10" Margin="0,0,12,0" Background="#312E81">
                                        <materialDesign:PackIcon Kind="Wallet" Width="20" Height="20"
                                                                 HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#818CF8"/>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Dijital Cüzdan" FontSize="13" FontWeight="SemiBold" Foreground="White" FontFamily="Segoe UI"/>
                                        <TextBlock Text="NFC &amp; akıllı üye kartı" FontSize="11" Foreground="#94A3B8" FontFamily="Segoe UI"/>
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Border Width="38" Height="38" CornerRadius="10" Margin="0,0,12,0" Background="#1E1B4B">
                                        <materialDesign:PackIcon Kind="ChartBubble" Width="20" Height="20"
                                                                 HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#A78BFA"/>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="UML &amp; Mimari" FontSize="13" FontWeight="SemiBold" Foreground="White" FontFamily="Segoe UI"/>
                                        <TextBlock Text="Canlı GoF tasarım desenleri" FontSize="11" Foreground="#94A3B8" FontFamily="Segoe UI"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </StackPanel>

                        <!-- Alt Bilgi Kutusu -->
                        <Border Margin="0,32,0,0" Padding="14,10" CornerRadius="10" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" Fill="#10B981" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="SQLite EF Core kalıcı veri tabanı motoru devrede"
                                           FontSize="11" Foreground="#94A3B8" FontFamily="Segoe UI"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Sağ Panel - Login Formu -->
            <Border Grid.Column="1" Background="#0A0F1E" BorderBrush="#1E293B" BorderThickness="1,0,0,0">
                <Grid>
                    <!-- Kapat butonu -->
                    <Button HorizontalAlignment="Right" VerticalAlignment="Top"
                            Width="36" Height="36" Margin="0,16,16,0"
                            Style="{StaticResource MaterialDesignIconButton}"
                            Foreground="#94A3B8"
                            Click="CloseButton_Click">
                        <materialDesign:PackIcon Kind="Close" Width="18" Height="18"/>
                    </Button>

                    <!-- Login formu -->
                    <StackPanel VerticalAlignment="Center" Margin="44,0">

                        <!-- Başlık -->
                        <TextBlock Text="Hoş Geldiniz" FontSize="28" FontWeight="Bold" Foreground="White"
                                   FontFamily="Segoe UI" Margin="0,0,0,6"/>
                        <TextBlock Text="Kütüphane otomasyon sistemine giriş yapın" FontSize="13" Foreground="#94A3B8"
                                   FontFamily="Segoe UI" Margin="0,0,0,28"/>

                        <!-- Kullanıcı Adı -->
                        <TextBlock Text="Kullanıcı Adı" FontSize="12" Foreground="#CBD5E1" FontWeight="SemiBold" Margin="0,0,0,6" FontFamily="Segoe UI"/>
                        <Border Background="#1E293B" CornerRadius="10" Padding="12,0" Margin="0,0,0,16" Height="46" BorderBrush="#334155" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <materialDesign:PackIcon Kind="Account" Width="18" Height="18" Foreground="#64748B"
                                                         VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBox Grid.Column="1" x:Name="txtKullaniciAdi"
                                         materialDesign:TextFieldAssist.DecorationVisibility="Hidden"
                                         BorderThickness="0" Background="Transparent"
                                         FontSize="14" FontFamily="Segoe UI"
                                         Foreground="White" CaretBrush="White"
                                         VerticalAlignment="Center"
                                         KeyDown="TxtKullaniciAdi_KeyDown"/>
                            </Grid>
                        </Border>

                        <!-- Şifre -->
                        <TextBlock Text="Şifre" FontSize="12" Foreground="#CBD5E1" FontWeight="SemiBold" Margin="0,0,0,6" FontFamily="Segoe UI"/>
                        <Border Background="#1E293B" CornerRadius="10" Padding="12,0" Margin="0,0,0,20" Height="46" BorderBrush="#334155" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <materialDesign:PackIcon Kind="Lock" Width="18" Height="18" Foreground="#64748B"
                                                         VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <PasswordBox Grid.Column="1" x:Name="txtSifre"
                                             materialDesign:TextFieldAssist.DecorationVisibility="Hidden"
                                             BorderThickness="0" Background="Transparent"
                                             FontSize="14" FontFamily="Segoe UI"
                                             Foreground="White" CaretBrush="White"
                                             VerticalAlignment="Center"
                                             KeyDown="TxtSifre_KeyDown"/>
                            </Grid>
                        </Border>

                        <!-- Hata mesajı -->
                        <Border x:Name="pnlHata" Visibility="Collapsed" CornerRadius="10" Padding="14,10"
                                Margin="0,0,0,16" BorderThickness="1" BorderBrush="#EF4444" Background="#1F0505">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="AlertCircle" Foreground="#EF4444" Width="18" Height="18"
                                                         VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock x:Name="txtHata" Foreground="#FCA5A5" FontSize="13"
                                           VerticalAlignment="Center" FontFamily="Segoe UI"/>
                            </StackPanel>
                        </Border>

                        <!-- Giriş Butonu -->
                        <Button x:Name="btnGiris"
                                Height="48" FontSize="14" FontWeight="Bold"
                                FontFamily="Segoe UI"
                                materialDesign:ButtonAssist.CornerRadius="12"
                                Click="BtnGiris_Click">
                            <Button.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#2563EB" Offset="0"/>
                                    <GradientStop Color="#7C3AED" Offset="1"/>
                                </LinearGradientBrush>
                            </Button.Background>
                            <Button.Foreground>
                                <SolidColorBrush Color="White"/>
                            </Button.Foreground>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Login" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="SİSTEME GİRİŞ YAP" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Yükleme göstergesi -->
                        <ProgressBar x:Name="pbYukleme" IsIndeterminate="True"
                                     Visibility="Collapsed" Margin="0,14,0,0"
                                     Style="{StaticResource MaterialDesignLinearProgressBar}"/>

                        <!-- Demo Hesaplar Kartı -->
                        <Border CornerRadius="12" Padding="14,12" Margin="0,24,0,0" BorderThickness="1" BorderBrush="#1E293B" Background="#0F172A">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <materialDesign:PackIcon Kind="AccountKey" Width="14" Height="14" Foreground="#94A3B8"
                                                             VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="HIZLI DEMO HESAP SEÇİMİ" FontSize="10" FontWeight="Bold" Foreground="#94A3B8"
                                               FontFamily="Segoe UI" VerticalAlignment="Center"/>
                                </StackPanel>

                                <!-- Admin Doldur Butonu -->
                                <Border Background="#1E293B" CornerRadius="8" Padding="10,6" Margin="0,0,0,6" Cursor="Hand"
                                        MouseLeftButtonUp="FillAdmin_Click">
                                    <Grid>
                                        <StackPanel>
                                            <TextBlock FontSize="12" FontFamily="Segoe UI">
                                                <Run FontWeight="Bold" Foreground="#38BDF8">admin</Run>
                                                <Run Foreground="#94A3B8"> / admin123</Run>
                                            </TextBlock>
                                            <TextBlock Text="Sistem Yöneticisi • Tam Yetki" FontSize="10" Foreground="#64748B"/>
                                        </StackPanel>
                                        <Border HorizontalAlignment="Right" VerticalAlignment="Center"
                                                CornerRadius="6" Padding="6,2" Background="#1E3A5F">
                                            <TextBlock Text="SEÇ" FontSize="9" FontWeight="Bold" Foreground="#38BDF8"/>
                                        </Border>
                                    </Grid>
                                </Border>

                                <!-- Kütüphaneci Doldur Butonu -->
                                <Border Background="#1E293B" CornerRadius="8" Padding="10,6" Cursor="Hand"
                                        MouseLeftButtonUp="FillFatma_Click">
                                    <Grid>
                                        <StackPanel>
                                            <TextBlock FontSize="12" FontFamily="Segoe UI">
                                                <Run FontWeight="Bold" Foreground="#34D399">fatmak</Run>
                                                <Run Foreground="#94A3B8"> / 123456</Run>
                                            </TextBlock>
                                            <TextBlock Text="Kütüphane Görevlisi" FontSize="10" Foreground="#64748B"/>
                                        </StackPanel>
                                        <Border HorizontalAlignment="Right" VerticalAlignment="Center"
                                                CornerRadius="6" Padding="6,2" Background="#064E3B">
                                            <TextBlock Text="SEÇ" FontSize="9" FontWeight="Bold" Foreground="#34D399"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
